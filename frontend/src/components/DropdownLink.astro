---
// Slot en vez de prop de texto: Propuestas envuelve el nombre en <span>,
// Ciudadanía no.
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a
  class="flex items-center gap-3 rounded-[3px] px-3 py-3.5 text-[0.82rem] hover:bg-base-200 max-nav:text-[0.88rem]"
  href={href}
>
  <slot />
</a>
