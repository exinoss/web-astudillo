---
import { TEXTO_ACEPTACION, VERSION_LEGAL } from '../lib/legal';

interface Props {
  id: string;
  hidden?: boolean;
  prompt?: string;
}
const { id, hidden = false, prompt } = Astro.props;
---

<div id={`${id}-block`} data-aceptacion data-version={VERSION_LEGAL} class="mt-6" hidden={hidden}>
  {prompt && <p class="m-0 mb-2.5 text-[0.87rem] font-medium leading-normal">{prompt}</p>}
  <label for={id} class="grid min-h-11 cursor-pointer grid-cols-[1.25rem_minmax(0,1fr)] items-start gap-3 text-[0.87rem] leading-6">
    <input id={id} name="aceptacion" type="checkbox" required aria-describedby={`${id}-error`}
      class="m-0 mt-0.5 size-5 appearance-auto rounded-none p-0 accent-primary" />
    <span class="block [overflow-wrap:anywhere]">{TEXTO_ACEPTACION}</span>
  </label>
  <div class="mt-1 ml-8 flex flex-wrap items-center gap-x-[18px] text-[0.82rem]">
    <a href="/terminos-y-condiciones/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center underline underline-offset-3">Términos y condiciones</a>
    <a href="/politica-de-privacidad/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center underline underline-offset-3">Política de privacidad</a>
  </div>
  <p id={`${id}-error`} class="m-0 mt-2 ml-8 text-[0.8rem] font-bold leading-normal text-error" role="alert" hidden></p>
</div>

<script>
  document.querySelectorAll<HTMLInputElement>('[data-aceptacion] input').forEach(input => {
    input.addEventListener('change', () => {
      input.removeAttribute('aria-invalid');
      const error = document.getElementById(`${input.id}-error`);
      if (error) { error.textContent = ''; error.hidden = true; }
    });
  });
</script>
