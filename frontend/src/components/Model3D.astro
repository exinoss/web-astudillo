---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import type { ProposalModel } from "../lib/data/types";
import { ORBITA } from "../lib/model3d.ts";

type Props = ProposalModel;
const { src, poster, alt } = Astro.props;

const posterClases =
  "model-3d-poster absolute inset-0 h-full w-full object-contain";
---

<figure
  class="model-3d mt-[30px] mb-0 rounded-[4px] bg-base-100 p-5 [border-right:1px_solid_#06317630] [border-bottom:1px_solid_#06317630] [border-left:1px_solid_#06317630] [border-top:4px_solid_var(--color-secondary)] [box-shadow:0_4px_14px_#06317608] max-tablet:p-3"
  data-src={src}
  data-alt={alt}
  data-orbita={ORBITA}
>
  <div class="model-3d-visor relative aspect-[16/10] [&:fullscreen]:bg-base-100 [&.is-expandido]:fixed [&.is-expandido]:inset-0 [&.is-expandido]:z-[950] [&.is-expandido]:aspect-auto [&.is-expandido]:bg-base-100">
    {typeof poster === "string" ? (
      <img class={posterClases} src={poster} alt={alt} />
    ) : (
      <Image
        class={posterClases}
        src={poster}
        alt={alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 760px) 90vw, 690px"
      />
    )}
    <button
      class="model-3d-cargar button absolute bottom-3 left-1/2 -translate-x-1/2"
      type="button"
      hidden
    >
      Ver en 3D
    </button>
    <button
      class="model-3d-completa absolute top-3 right-3 z-10 grid size-11 place-items-center rounded-[4px] border border-base-300 bg-base-100/90 text-primary hover:bg-base-200 [&[aria-pressed=true]_.icono-expandir]:hidden [&[aria-pressed=false]_.icono-reducir]:hidden"
      type="button"
      aria-label="Ver en pantalla completa"
      aria-pressed="false"
      hidden
    >
      <span class="icono-expandir"><Icon name="expand" size={20} /></span>
      <span class="icono-reducir"><Icon name="collapse" size={20} /></span>
    </button>
  </div>
  <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[0.72rem] text-base-content">
    <span class="font-bold tracking-[0.1em] uppercase">Modelo 3D</span>
    <span class="pointer-coarse:hidden">
      Arrastra para girar · Rueda para acercar
    </span>
    <span class="hidden pointer-coarse:inline">
      Desliza para girar · Pellizca para acercar
    </span>
  </figcaption>
</figure>

<script>
  // La carga por URL permite reintentar; el navegador memoriza imports fallidos.
  import visorUrl from "@google/model-viewer/dist/model-viewer.min.js?url";
  import decodificadorUrl from "meshoptimizer/decoder?url";

  const bloques = [...document.querySelectorAll<HTMLElement>(".model-3d")];

  let libreria: Promise<unknown> | undefined;
  let intentos = 0;
  /** Descarga decodificador y visor antes del primer modelo. */
  const cargarLibreria = () =>
    (libreria ??= (async () => {
      const respuesta = await fetch(decodificadorUrl);
      if (!respuesta.ok) throw new Error(`decodificador: ${respuesta.status}`);
      // model-viewer espera un script clásico; se quita `export` y se sirve como Blob.
      const codigo = (await respuesta.text()).replace(
        "export { MeshoptDecoder };",
        "",
      );
      const url = URL.createObjectURL(
        new Blob([codigo], { type: "text/javascript" }),
      );
      // El decodificador debe configurarse antes de cargar model-viewer.
      (self as any).ModelViewerElement = { meshoptDecoderLocation: url };
      await new Promise((resolver, rechazar) => {
        const script = document.createElement("script");
        script.type = "module";
        script.src = intentos ? `${visorUrl}?reintento=${intentos}` : visorUrl;
        script.onload = resolver;
        script.onerror = rechazar;
        document.head.append(script);
      });
    })());

  const html = document.documentElement;
  const sinMovimiento = () => html.classList.contains("reduce-motion");

  /** Monta el visor en el bloque y ofrece reintento si falla la carga. */
  async function montar(bloque: HTMLElement) {
    try {
      await cargarLibreria();
    } catch (error) {
      console.error("No se pudo cargar el visor 3D:", error);
      // Limpia la promesa fallida para que el botón permita reintentar.
      libreria = undefined;
      intentos++;
      ofrecerBoton(bloque);
      return;
    }
    const contenedor = bloque.querySelector<HTMLElement>(".model-3d-visor")!;
    const visor = document.createElement("model-viewer");
    visor.className = "absolute inset-0 h-full w-full";
    visor.setAttribute("src", bloque.dataset.src!);
    visor.setAttribute("alt", bloque.dataset.alt!);
    visor.setAttribute("camera-orbit", bloque.dataset.orbita!);
    visor.setAttribute("shadow-intensity", "1");
    visor.setAttribute("camera-controls", "");
    visor.setAttribute("disable-pan", "");
    visor.setAttribute("touch-action", "pan-y");
    visor.setAttribute("interaction-prompt", "none");
    visor.style.setProperty("--poster-color", "transparent");
    visor.style.setProperty("--progress-bar-color", "var(--color-secondary)");
    if (!sinMovimiento()) visor.setAttribute("auto-rotate", "");
    visor.addEventListener(
      "load",
      () => {
        contenedor.querySelector(".model-3d-poster")?.remove();
        prepararPantallaCompleta(contenedor, visor);
      },
      { once: true },
    );
    contenedor.append(visor);
  }

  /**
   * Pantalla completa con la API nativa; donde no existe (Safari en iPhone) el visor
   * se fija a toda la ventana. Dentro, el gesto vertical gira el modelo en vez de desplazar.
   */
  function prepararPantallaCompleta(contenedor: HTMLElement, visor: HTMLElement) {
    const boton = contenedor.querySelector<HTMLButtonElement>(".model-3d-completa")!;
    const nativa = typeof contenedor.requestFullscreen === "function";
    const reflejar = (activa: boolean) => {
      boton.setAttribute("aria-pressed", String(activa));
      boton.setAttribute("aria-label", activa ? "Salir de pantalla completa" : "Ver en pantalla completa");
      visor.setAttribute("touch-action", activa ? "none" : "pan-y");
    };
    const expandir = (activa: boolean) => {
      contenedor.classList.toggle("is-expandido", activa);
      html.classList.toggle("overflow-hidden", activa);
      reflejar(activa);
    };
    boton.hidden = false;
    boton.addEventListener("click", () => {
      if (contenedor.classList.contains("is-expandido")) expandir(false);
      else if (document.fullscreenElement === contenedor) document.exitFullscreen();
      else if (nativa) contenedor.requestFullscreen().catch(() => expandir(true));
      else expandir(true);
    });
    document.addEventListener("fullscreenchange", () =>
      reflejar(document.fullscreenElement === contenedor),
    );
    document.addEventListener("keydown", (evento) => {
      if (evento.key === "Escape" && contenedor.classList.contains("is-expandido")) {
        expandir(false);
        boton.focus();
      }
    });
  }

  new MutationObserver(() => {
    for (const visor of document.querySelectorAll("model-viewer")) {
      visor.toggleAttribute("auto-rotate", !sinMovimiento());
    }
  }).observe(html, { attributes: true, attributeFilter: ["class"] });

  /** Deja el modelo bajo demanda cuando falla la carga o hay ahorro de datos. */
  function ofrecerBoton(bloque: HTMLElement) {
    const boton = bloque.querySelector<HTMLButtonElement>(".model-3d-cargar")!;
    boton.hidden = false;
    boton.addEventListener(
      "click",
      () => {
        boton.hidden = true;
        montar(bloque);
      },
      { once: true },
    );
  }

  const ahorroDatos = (navigator as any).connection?.saveData === true;

  if (ahorroDatos) {
    bloques.forEach(ofrecerBoton);
  } else {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          observador.unobserve(entrada.target);
          montar(entrada.target as HTMLElement);
        }
      },
      { rootMargin: "200px" },
    );
    for (const bloque of bloques) observador.observe(bloque);
  }
</script>
