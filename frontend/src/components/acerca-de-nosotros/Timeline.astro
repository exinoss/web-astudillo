---
import Icon from "../comun/Icon.astro";
import Foto from "../comun/Foto.astro";
import Editable from "../comun/Editable.astro";
import type { BiographyMilestone } from "../../lib/data/types";

interface Props {
  milestones: BiographyMilestone[];
}
const { milestones } = Astro.props;

// Los hitos solo se ocultan para la animación de entrada cuando el script añade `.linea-animada`.
const oculto =
  "in-[.linea-animada]:not-[.is-visible]:opacity-0 max-tablet:in-[.linea-animada]:not-[.is-visible]:translate-x-0 max-tablet:in-[.linea-animada]:not-[.is-visible]:translate-y-5";
---

<div class="linea-tiempo relative mx-auto w-full max-w-[1080px] [overflow-x:clip]">
  <div class="linea absolute top-[var(--inicio-linea,0px)] left-1/2 z-[1] h-[calc(100%-var(--inicio-linea,0px))] w-0.5 -translate-x-px bg-neutral/20 max-tablet:left-5">
    <div class="linea-relleno absolute inset-x-0 top-0 h-0 bg-neutral"></div>
  </div>
  <div class="linea-intro relative z-[3] flex flex-col items-center gap-2.5 pb-2.5 transition-[opacity,visibility] duration-400 max-tablet:items-start [&.is-oculta]:invisible [&.is-oculta]:opacity-0">
    <Editable clave="biografia.recorre" class="text-[0.69rem] font-bold tracking-[0.16em] text-neutral uppercase" />
    <button
      class="linea-intro-boton grid size-10 place-items-center rounded-full bg-neutral text-neutral-content shadow-[0_3px_12px_#05499459] animate-rebote hover:bg-campaign-red"
      type="button"
      aria-label="Bajar al primer momento de su historia"
    >
      <Icon name="chevron" size={15} />
    </button>
  </div>
  {milestones.map((hito, i) => {
    const fotoIzquierda = i % 2 === 0;
    const ultimo = i === milestones.length - 1;
    const punto =
      "punto absolute top-1/2 left-1/2 z-[3] grid size-4 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-[3px] border-base-100 bg-neutral p-0 text-base-100 shadow-[0_0_0_1px_#05499499] transition-[width,height,background-color,box-shadow] duration-300 group-[.is-current]/hito:bg-campaign-red group-[.is-current]/hito:shadow-[0_0_0_1px_#e0121f99,0_0_0_7px_#e0121f24] max-tablet:top-[30px] max-tablet:left-5 max-tablet:translate-y-0";
    return (
      <article
        class:list={[
          "hito group/hito relative z-[2] flex items-center gap-[60px] py-8 [scroll-margin-top:30px] transition-[opacity,translate] duration-700 max-tablet:flex-col max-tablet:items-start max-tablet:gap-4 max-tablet:py-6 max-tablet:pl-[50px]",
          oculto,
          fotoIzquierda
            ? "in-[.linea-animada]:not-[.is-visible]:-translate-x-10"
            : "in-[.linea-animada]:not-[.is-visible]:translate-x-10",
        ]}
      >
        {ultimo ? (
          <span class={punto} />
        ) : (
          <button
            class:list={[
              punto,
              "cursor-pointer before:absolute before:-inset-[14px] before:rounded-full before:content-[''] hover:size-[34px] hover:bg-campaign-red group-[.is-current]/hito:size-[34px] [&_svg]:opacity-0 [&_svg]:transition-opacity hover:[&_svg]:opacity-100 group-[.is-current]/hito:[&_svg]:opacity-100",
            ]}
            type="button"
            aria-label="Ir al siguiente momento de su historia"
          >
            <Icon name="chevron" size={13} />
          </button>
        )}
        <div
          class:list={[
            "min-h-[220px] min-w-0 flex-1 overflow-hidden rounded-[12px] border border-dashed border-neutral/35 bg-neutral/8 max-tablet:order-2 max-tablet:w-full",
            fotoIzquierda ? "order-1" : "order-2",
          ]}
        >
          {hito.image ? (
            <Foto
              class="block h-full min-h-[220px] w-full object-cover"
              picture={hito.image}
              alt={hito.alt}
              widths={[400, 640, 960]}
              sizes="(max-width: 760px) 90vw, 500px"
            />
          ) : (
            <span class="grid h-full min-h-[220px] place-items-center text-[0.8rem] text-neutral">Foto pendiente</span>
          )}
        </div>
        <div
          class:list={[
            "min-w-0 flex-1 max-tablet:order-1 max-tablet:text-left",
            fotoIzquierda ? "order-2" : "order-1 text-right",
          ]}
        >
          {/* Relleno interno y no en la columna: en flex se sumaría a su ancho y descentraría el punto.
              Aparta el texto de la cinta roja del fondo fijo. */}
          <div class:list={[!fotoIzquierda && "pl-[90px] max-desktop-sm:pl-10 max-tablet:pl-0"]}>
            <p class="m-0 mb-3 font-display text-[2.75rem] leading-none font-bold text-neutral max-tablet:text-[2rem]">
              {hito.years}
            </p>
            <h2 class="m-0 mb-3.5 text-[1.6rem] leading-[1.2] text-neutral max-tablet:text-[1.35rem]">
              {hito.title}
            </h2>
            {hito.text.map((parrafo) => (
              <p class="m-0 mb-3.5 text-[0.94rem] leading-[1.6] last:mb-0">{parrafo}</p>
            ))}
          </div>
        </div>
      </article>
    );
  })}
</div>

<script src="../../scripts/acerca-de-nosotros/biografia.ts"></script>
