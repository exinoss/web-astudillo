---
import Icon from "../comun/Icon.astro";
import FormularioParticipacion from "./FormularioParticipacion.astro";
import { TIPOS_ALERTA } from "../../lib/ciudadania/participacion/tipos";
import { FORMATOS_FOTO } from "../../../../backend/src/contracts/media";
import { LARGOS_PARTICIPACION as LARGOS, MAX_MB_FOTO_ALERTA, MIN_DESCRIPCION_ALERTA } from "../../../../backend/src/contracts/participacion";
import { ETIQUETA, AYUDA, ERROR } from "./estilos";
import { MENSAJE_CAMPO } from "../../lib/comun/campos";
---

<FormularioParticipacion nombre="alerta" titulo="Cuéntanos lo que pasa." intro="Elige el tipo de problema, indica el barrio y, si puedes, añade una foto." encabezado="Nueva alerta" historial="Tus alertas">
  <p slot="nota" class="text-[0.82rem] text-base-content mt-[20px]">Este espacio no recibe emergencias ni genera reportes oficiales.</p>
  <fieldset id="alerta-tipo" class="m-0 grid min-w-0 grid-cols-3 gap-2.5 border-0 p-0 max-mobile:grid-cols-2 aria-invalid:[&_.opcion]:border-error" aria-describedby="alerta-tipo-error">
    <legend class:list={[ETIQUETA, "mt-0"]}>¿Qué tipo de problema es? *</legend>
    {TIPOS_ALERTA.map((t) => (
      <label class="relative block cursor-pointer">
        <input class="peer absolute inset-0 m-0 cursor-pointer opacity-0" type="radio" name="tipo" value={t.valor} />
        <span class="opcion flex min-h-[78px] flex-col items-center justify-center gap-1.5 rounded-card border border-field-border bg-base-100 px-1.5 py-2.5 text-center text-[0.82rem] font-bold text-primary transition-colors hover:border-primary peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-content peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-neutral">
          <Icon name={t.icono} size={26} />
          {t.nombre}
        </span>
      </label>
    ))}
  </fieldset>
  <p id="alerta-tipo-error" class={ERROR} hidden></p>

  <label class={ETIQUETA} for="alerta-sector">Sector o barrio *</label>
  <input id="alerta-sector" class="campo" name="sector" placeholder="Indica el sector" maxlength={LARGOS.sector} aria-describedby="alerta-sector-error" />
  <p id="alerta-sector-error" class={MENSAJE_CAMPO} hidden></p>

  <label class={ETIQUETA} for="alerta-referencia">Dirección o punto de referencia <span class="font-normal text-base-content">(opcional)</span></label>
  <input id="alerta-referencia" class="campo" name="referencia" maxlength={LARGOS.referencia} placeholder="Por ejemplo: frente al parque, calle principal" />

  <label class={ETIQUETA} for="alerta-descripcion">¿Qué está ocurriendo? *</label>
  <textarea id="alerta-descripcion" class="campo min-h-[110px] resize-y" name="descripcion" rows="4" maxlength={LARGOS.descripcion} placeholder="Describe la situación y dónde ocurre…" aria-describedby="alerta-descripcion-ayuda alerta-descripcion-error"></textarea>
  <p id="alerta-descripcion-ayuda" class={AYUDA}>Mínimo {MIN_DESCRIPCION_ALERTA} caracteres. Evita incluir datos sensibles.</p>
  <p id="alerta-descripcion-error" class={MENSAJE_CAMPO} hidden></p>

  <span class={ETIQUETA}>Foto del problema <span class="font-normal text-base-content">(opcional)</span></span>
  <!-- Sin «capture»: así el celular ofrece cámara o galería. -->
  <label id="alerta-foto-zona" class="relative flex min-h-[190px] cursor-pointer flex-col items-center justify-center gap-2.5 rounded-[6px] border-2 border-dashed border-field-border bg-[#f4f7fb] px-4 py-6 text-center text-primary transition-colors hover:border-primary hover:bg-[#eaf0f8] focus-within:outline-3 focus-within:outline-offset-2 focus-within:outline-neutral">
    <input id="alerta-foto" class="absolute inset-0 cursor-pointer opacity-0" type="file" accept="image/*" aria-describedby="alerta-foto-error" />
    <span class="grid size-[76px] place-items-center rounded-full bg-primary text-primary-content"><Icon name="camera" size={38} /></span>
    <strong class="text-base">Toca para añadir una foto</strong>
    <small class="text-[0.78rem] text-base-content">Cámara o galería · {FORMATOS_FOTO} · hasta {MAX_MB_FOTO_ALERTA} MB</small>
  </label>
  <div id="alerta-foto-vista" class="grid grid-cols-[96px_1fr] items-center gap-3.5 rounded-[6px] border border-base-300 p-2.5" hidden>
    <img class="size-24 rounded-card object-cover" alt="Vista previa de la foto del problema" />
    <div class="flex min-w-0 flex-col gap-2 text-[0.78rem] wrap-anywhere">
      <span id="alerta-foto-nombre"></span>
      <button id="alerta-foto-quitar" type="button" class="min-h-11 self-start rounded-control border border-primary bg-base-100 px-3.5 text-[0.8rem]">Quitar foto</button>
    </div>
  </div>
  <p id="alerta-foto-error" class={ERROR} role="alert" hidden></p>
</FormularioParticipacion>
<script src="../../scripts/ciudadania/alerta.ts"></script>
