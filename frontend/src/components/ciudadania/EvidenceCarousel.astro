---
import CarruselFotos from "../comun/CarruselFotos.astro";
import Icon from "../comun/Icon.astro";
import type { WorkEvidence } from "../../lib/data/types";

interface Props {
  id: string;
  evidence: WorkEvidence[];
  name: string;
}
const { id, evidence, name } = Astro.props;
---

{evidence.length ? (
  <div class="evidencias-acordeon group h-full">
  <button
    class="evidencias-desplegar hidden min-h-12 w-full items-center justify-between gap-3 rounded-[4px] border border-base-300 bg-base-100 px-4 text-[0.85rem] font-bold text-primary max-tablet:flex"
    type="button"
    aria-expanded="false"
    aria-controls={`evidencias-${id}`}
  >
    <span class="flex items-center gap-2.5">
      <Icon name="image" size={20} />
      Fotos del avance ({evidence.length})
    </span>
    <span class="transition-transform duration-200 group-[.is-abierto]:rotate-180"><Icon name="chevron" size={18} /></span>
  </button>
  <CarruselFotos
    id={`evidencias-${id}`}
    label={`Evidencias del avance de ${name}`}
    photos={evidence}
    sizes="(max-width: 760px) 90vw, 620px"
    class="h-full min-h-[340px] max-tablet:mt-2 max-tablet:hidden max-tablet:aspect-[4/3] max-mobile:aspect-square max-tablet:h-auto max-tablet:min-h-0 max-tablet:group-[.is-abierto]:block"
  />
  </div>
) : (
  <div class="flex h-full min-h-[340px] flex-col items-center justify-center gap-3 rounded-[4px] border border-dashed border-base-300 bg-base-100/60 p-6 text-center text-[0.85rem] text-primary max-tablet:min-h-0 max-tablet:flex-row max-tablet:justify-start max-tablet:p-4 max-tablet:text-left">
    <Icon name="obras" size={30} />
    Aún no hay imágenes del avance de esta obra.
  </div>
)}

<script src="../../scripts/ciudadania/evidencias.ts"></script>
