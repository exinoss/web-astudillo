---
import Icon from "../comun/Icon.astro";
import FormularioParticipacion from "./FormularioParticipacion.astro";
import type { Proposal } from "../../lib/data/types";
import { LARGOS_PARTICIPACION, MIN_MENSAJE_SUGERENCIA } from "../../../../backend/src/contracts/participacion";
import { ETIQUETA, AYUDA, ERROR } from "./estilos";
import { MENSAJE_CAMPO } from "../../lib/comun/campos";

interface Props {
  proposals: Proposal[];
}
const { proposals } = Astro.props;
const temas = [...proposals.map((p) => ({ valor: p.slug, nombre: p.name, icono: p.icon })), { valor: "otro", nombre: "Otra idea", icono: "idea" }];
---

<FormularioParticipacion nombre="sugerencia" titulo="Las ideas empiezan contigo." intro="Elige un tema y comparte tu sugerencia de forma clara." encabezado="Tu sugerencia" historial="Tus sugerencias" temas={JSON.stringify(temas)}>
  <fieldset id="sugerencia-tema" class="m-0 flex min-w-0 flex-wrap gap-2 border-0 p-0 aria-invalid:[&_.opcion]:border-error" aria-describedby="sugerencia-tema-error">
    <legend class:list={[ETIQUETA, "mt-0"]}>¿Sobre qué tema? *</legend>
    {temas.map((t) => (
      <label class="relative block cursor-pointer">
        <input class="peer absolute inset-0 m-0 cursor-pointer opacity-0" type="radio" name="tema" value={t.valor} />
        <span class="opcion flex min-h-11 items-center gap-2 rounded-full border border-field-border bg-base-100 px-4 py-2 text-[0.8rem] font-bold text-primary transition-colors hover:border-primary peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-content peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-neutral">
          <Icon name={t.icono} size={18} />
          {t.nombre}
        </span>
      </label>
    ))}
  </fieldset>
  <p id="sugerencia-tema-error" class={ERROR} hidden></p>

  <label class={ETIQUETA} for="sugerencia-mensaje">¿Qué te gustaría proponer? *</label>
  <textarea id="sugerencia-mensaje" class="campo min-h-[110px] resize-y" name="mensaje" rows="5" maxlength={LARGOS_PARTICIPACION.mensaje} placeholder="Cuéntanos tu idea…" aria-describedby="sugerencia-mensaje-ayuda sugerencia-mensaje-error"></textarea>
  <p id="sugerencia-mensaje-ayuda" class={AYUDA}>Mínimo {MIN_MENSAJE_SUGERENCIA} caracteres. Evita incluir datos sensibles.</p>
  <p id="sugerencia-mensaje-error" class={MENSAJE_CAMPO} hidden></p>
</FormularioParticipacion>
<script src="../../scripts/ciudadania/sugerencia.ts"></script>
