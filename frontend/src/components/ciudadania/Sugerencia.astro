---
import Icon from "../Icon.astro";
import LegalAcceptance from '../LegalAcceptance.astro';
import type { Proposal } from "../../lib/data/types";
import { MIN_SUGERENCIA } from "../../lib/participacion/tipos";
import { TARJETA, CAMPO, ETIQUETA, AYUDA, ERROR, ESTADO } from "./estilos";

interface Props {
  proposals: Proposal[];
}
const { proposals } = Astro.props;
const temas = [...proposals.map((p) => ({ valor: p.slug, nombre: p.name, icono: p.icon })), { valor: "otro", nombre: "Otra idea", icono: "idea" }];
---

<section class="site-container grid max-w-[1100px] grid-cols-[1fr_1.2fr] items-start gap-[100px] pt-8 pb-14 max-nav:gap-[35px] max-tablet:pt-6 max-tablet:pb-10 max-tablet:grid-cols-1 max-tablet:gap-[30px]">
  <div class="citizen-explanation">
    <span class="eyebrow">UN ESPACIO PARA TI</span>
    <h2>Las ideas empiezan contigo.</h2>
    <p>Elige un tema y comparte tu sugerencia de forma clara.</p>
  </div>
  <form id="sugerencia-form" class={TARJETA} novalidate>
    <p id="sugerencia-recuperada" class="mt-0 mb-[18px] border-l-4 border-neutral bg-[#eef4fb] px-4 py-3 text-[0.84rem] leading-normal" role="status" hidden>
      Recuperamos tu sugerencia. Revísala antes de enviarla.
    </p>
    <div class="mb-5 flex items-center justify-between gap-[15px] max-nav:flex-col max-nav:items-start max-nav:gap-2">
      <h3 class="m-0 max-tablet:text-[1.1rem]">Tu sugerencia</h3>
      <span class="text-[0.73rem] text-base-content">* Campos obligatorios</span>
    </div>
    <fieldset id="sugerencia-tema" class="m-0 flex min-w-0 flex-wrap gap-2 border-0 p-0 aria-invalid:[&_.opcion]:border-error" aria-describedby="sugerencia-tema-error">
      <legend class:list={[ETIQUETA, "mt-0"]}>¿Sobre qué tema? *</legend>
      {temas.map((t) => (
        <label class="relative block cursor-pointer">
          <input class="peer absolute inset-0 m-0 cursor-pointer opacity-0" type="radio" name="tema" value={t.valor} />
          <span class="opcion flex min-h-11 items-center gap-2 rounded-full border border-field-border bg-base-100 px-4 py-2 text-[0.8rem] font-bold text-primary transition-colors hover:border-primary peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-content peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-neutral">
            <Icon name={t.icono} size={18} />
            {t.nombre}
          </span>
        </label>
      ))}
    </fieldset>
    <p id="sugerencia-tema-error" class={ERROR} hidden></p>

    <label class={ETIQUETA} for="sugerencia-mensaje">¿Qué te gustaría proponer? *</label>
    <textarea id="sugerencia-mensaje" class={CAMPO} name="mensaje" rows="5" maxlength="1500" placeholder="Cuéntanos tu idea…" aria-describedby="sugerencia-mensaje-ayuda sugerencia-mensaje-error"></textarea>
    <p id="sugerencia-mensaje-ayuda" class={AYUDA}>Mínimo {MIN_SUGERENCIA} caracteres. Evita incluir datos sensibles.</p>
    <p id="sugerencia-mensaje-error" class={ERROR} hidden></p>

    <LegalAcceptance id="sugerencia-aceptacion" hidden prompt="Antes de enviar tu sugerencia, confirma:" />
    <button class="button mt-6 data-[aceptacion-pendiente=true]:w-full" type="submit"><span data-envio-texto>Enviar sugerencia</span> <Icon name="arrow" size={18} /></button>
    <p id="sugerencia-estado" class={ESTADO} role="status" hidden></p>
  </form>
</section>
<script src="../../scripts/ciudadania/sugerencia.ts"></script>
