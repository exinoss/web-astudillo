---
import type { UploadedPicture } from "../../lib/data/types";
import { uploadedSrcset, uploadedUrl } from "../../lib/comun/fotos";

interface Props {
  picture: UploadedPicture;
  alt: string;
  class?: string;
  sizes: string;
  loading?: "lazy" | "eager";
}
const { picture, alt, class: className, sizes, loading = "lazy" } = Astro.props;
---

<img
  class={className}
  src={uploadedUrl(picture, picture.anchos.at(-1)!)}
  srcset={uploadedSrcset(picture)}
  sizes={sizes}
  width={picture.ancho}
  height={picture.alto}
  alt={alt}
  loading={loading}
  decoding="async"
/>
