---
import Icon from "./Icon.astro";
import { SALUDO } from "../../lib/comun/guia/pasos";

interface Props {
  inicio?: boolean;
}
const { inicio = false } = Astro.props;
const boton = "min-h-11 min-w-11 cursor-pointer rounded-full border-0 bg-primary-soft text-primary focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-accent";
const control = `${boton} inline-grid place-items-center`;
const conTexto = `${boton} inline-flex items-center gap-1.5 px-3.5 text-[0.85rem] font-bold`;
---

<div data-guia hidden>
  <div data-guia-escenario aria-hidden="true" class="pointer-events-none fixed bottom-0 left-0 z-[90] aspect-[4/3] w-[clamp(180px,22vw,300px)] [transition:transform_0.7s_cubic-bezier(0.45,0,0.2,1)] celular:w-[min(180px,50vw)]"></div>
  <div data-guia-caja role="region" aria-label="Guía de la página" class="fixed z-[91] w-[min(380px,calc(100vw-24px))] rounded-[12px] bg-base-100 px-3.5 pt-3.5 pb-2.5 text-primary [box-shadow:0_10px_40px_var(--color-primary-line)] [transition:left_0.7s_cubic-bezier(0.45,0,0.2,1)] celular:px-2.5 celular:pt-2 celular:pb-1">
    <p data-guia-texto aria-live="polite" class="m-0 text-base leading-normal font-medium celular:text-sm celular:leading-[1.3]"></p>
    <div data-guia-controles class="mt-2 flex items-center gap-1.5 celular:mt-1">
      <button type="button" data-guia-pausa class={control} aria-label="Pausar la guía">
        <span data-pausar><Icon name="pause" size={20} /></span><span data-reanudar hidden><Icon name="play" size={20} /></span>
      </button>
      <button type="button" data-guia-voz class={control} aria-label="Silenciar a Carlos" aria-pressed="false">
        <span data-con-voz><Icon name="volume" size={20} /></span><span data-sin-voz hidden><Icon name="volumeOff" size={20} /></span>
      </button>
      <button type="button" data-guia-continuar class={conTexto} hidden><Icon name="play" size={18} /> Continuar</button>
      <button type="button" data-guia-reintentar class={conTexto} hidden>Reintentar</button>
      <button type="button" data-guia-saltar class={`${conTexto} ml-auto celular:px-3 celular:whitespace-nowrap`}>Saltar guía <Icon name="close" size={16} /></button>
    </div>
  </div>
</div>
{inicio && (
  <button
    type="button"
    data-guia-abrir
    aria-label="Ver la guía de la página"
    class="fixed right-16 bottom-3 z-[80] grid size-11 place-items-center rounded-card border-2 border-base-100 bg-accent text-primary [box-shadow:0_3px_15px_var(--color-card-border)]"
  >
    <Icon name="play" size={22} />
  </button>
  <div data-guia-invitacion role="dialog" aria-label="Guía de la página" hidden class="pointer-events-none fixed bottom-0 left-3 z-[91] flex items-end text-primary max-tablet:right-3 max-tablet:flex-col max-tablet:items-start">
    <div data-guia-escena aria-hidden="true" class="aspect-[4/3] w-[280px] flex-none animate-subir max-tablet:order-2 max-tablet:w-[170px]"></div>
    <div class="pointer-events-auto relative mb-[100px] -ml-[34px] w-max max-w-[380px] origin-bottom-left animate-aparecer rounded-2xl bg-base-100 px-4 pt-3.5 pb-4 [box-shadow:0_10px_40px_var(--color-primary-line)] before:absolute before:bottom-[22px] before:left-[-9px] before:border-[10px] before:border-l-0 before:border-transparent before:border-r-base-100 before:content-[''] max-tablet:order-1 max-tablet:m-0 max-tablet:-mb-1 max-tablet:w-auto max-tablet:max-w-none max-tablet:self-stretch max-tablet:before:bottom-[-9px] max-tablet:before:left-[70px] max-tablet:before:border-b-0 max-tablet:before:border-l-[10px] max-tablet:before:border-r-transparent max-tablet:before:border-t-base-100">
      <p class="m-0 text-[1.15rem] leading-[1.3] font-bold">{SALUDO.texto}</p>
      <div class="mt-3 flex gap-2">
        <button type="button" data-guia-ver class="button flex-auto px-4"><Icon name="play" size={18} /> Ver la guía</button>
        <button type="button" data-guia-no class="button button-light flex-auto px-4">No, gracias</button>
      </div>
    </div>
  </div>
)}
<script src="../../scripts/comun/guia/index.ts"></script>
