---
import { TARJETA_CUENTA } from '../../lib/cuenta/tarjeta';

interface Props { heading: string; description?: string }
const { heading, description } = Astro.props;
---

<section class={`w-full ${TARJETA_CUENTA} px-9 py-8 max-tablet:pr-5 max-tablet:pl-[26px] max-tablet:py-6`}>
  <h2 class="m-0 mb-[7px] text-[2.5rem] max-tablet:text-[2.25rem]">{heading}</h2>
  {description && <p class="m-0 mb-5 text-sm leading-normal">{description}</p>}
  <slot />
</section>
