---
import { BOTON_MOSTRAR, MENSAJE_CAMPO } from '../../lib/comun/campos';

interface Props {
  id: string; name: string; label: string; type?: 'text' | 'email' | 'password';
  placeholder?: string; autocomplete?: string; required?: boolean; maxLength?: number;
  hint?: string; value?: string;
}
const { id, name, label, type = 'text', placeholder, autocomplete, required = false,
  maxLength, hint, value } = Astro.props;
---

<div class="mb-[17px]">
  <label for={id} class="block text-[0.82rem] font-bold">{label}</label>
  <div class="relative mt-[7px]">
    <input id={id} name={name} type={type} placeholder={placeholder} autocomplete={autocomplete}
      required={required} maxlength={maxLength} value={value}
      aria-describedby={`${id}-error${hint ? ` ${id}-hint` : ''}`}
      class:list={['campo', { 'pr-[90px]': type === 'password' }]} />
    {type === 'password' && <button type="button" class={BOTON_MOSTRAR} data-target={id} aria-label={`Mostrar ${label.toLowerCase()}`} aria-pressed="false">Mostrar</button>}
  </div>
  {hint && <p id={`${id}-hint`} class="m-0 mt-1.5 text-[0.72rem] leading-normal text-muted">{hint}</p>}
  <p id={`${id}-error`} class={MENSAJE_CAMPO} hidden></p>
</div>
