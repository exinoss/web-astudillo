---
import { contentRepository } from "../../lib/data";
import { enlaceRedValido, normalizarWhatsapp, REDES, REDES_SOCIALES, type RedSocial, whatsappUrl } from "../../lib/comun/contenido/redes";
import { CORREO_LEGAL } from "../../lib/legal/legal";
const texts = await contentRepository.getTexts();
const phone = normalizarWhatsapp(texts[REDES.whatsapp.clave] ?? "");
// El número de la semilla es de prueba y no identifica al responsable.
const originalPhone = (await contentRepository.getInitialTexts())[REDES.whatsapp.clave] ?? '';
const publicPhone = /^\d{10,15}$/.test(phone) && phone !== normalizarWhatsapp(originalPhone) ? phone : null;
const socialLinks = (Object.keys(REDES_SOCIALES) as RedSocial[])
  .filter(red => enlaceRedValido(red, texts[REDES[red].clave] ?? ""))
  .map(red => ({ href: texts[REDES[red].clave], name: REDES[red].nombre }));
---

<ul>
  <li><strong>Responsable del sitio y de tus datos:</strong> Carlos Astudillo.</li>
  <li><strong>Domicilio indicado, sede del partido:</strong> Av. Esmeraldas y C. 29 de Abril, 080501 San Lorenzo, Esmeraldas, Ecuador.</li>
  <li><strong>Correo de contacto y solicitudes sobre tus datos:</strong> <a href={`mailto:${CORREO_LEGAL}`}>{CORREO_LEGAL}</a>.</li>
  {publicPhone && <li><strong>Teléfono / WhatsApp de atención:</strong> <a href={whatsappUrl(publicPhone)} rel="noopener noreferrer">+{publicPhone}</a>.</li>}
  {socialLinks.length > 0 && <li><strong>Canales adicionales:</strong> {socialLinks.map((link, index) => <>{index > 0 && " · "}<a href={link.href} rel="noopener noreferrer">{link.name}</a></>)}.</li>}
  <li><strong>Sitio web:</strong> <a href="https://lanuevahistoria.tech/">lanuevahistoria.tech</a>.</li>
</ul>
