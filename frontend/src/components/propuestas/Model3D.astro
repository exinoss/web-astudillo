---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { Image } from "astro:assets";
import Icon from "../comun/Icon.astro";
import type { ProposalModel } from "../../lib/data/types";
import { MODELOS_RECORRIBLES, ORBITA, ORBITA_RECORRIDO } from "../../lib/propuestas/model3d.ts";

type Props = ProposalModel;
const { src, poster, alt } = Astro.props;

// Desde este peso el modelo no se descarga solo: lo pide la persona con el botón.
const PESADO = 5_000_000;
let bytes = 0;
let huella = "";
try {
  // La compilación, también la del publicador, corre con cwd en frontend/.
  const archivo = readFileSync(join(process.cwd(), "public", src));
  bytes = archivo.length;
  huella = createHash("sha1").update(archivo).digest("hex").slice(0, 12);
} catch {}
const pesado = bytes >= PESADO;
const megas = Math.round(bytes / 1_000_000);
const recorrible = MODELOS_RECORRIBLES.includes(src);

const posterClases =
  "model-3d-poster absolute inset-0 h-full w-full object-contain";
---

<figure
  class="model-3d mt-[30px] mb-0 rounded-[4px] bg-base-100 p-5 [border-right:1px_solid_var(--color-card-border)] [border-bottom:1px_solid_var(--color-card-border)] [border-left:1px_solid_var(--color-card-border)] [border-top:4px_solid_var(--color-secondary)] shadow-card max-tablet:p-3"
  data-src={pesado ? `${src}?v=${huella}` : src}
  data-alt={alt}
  data-orbita={recorrible ? ORBITA_RECORRIDO : ORBITA}
  data-recorrible={recorrible ? "" : undefined}
  data-pesado={pesado ? "" : undefined}
  data-megas={megas}
  data-bytes={bytes}
>
  <div class="model-3d-visor relative aspect-[16/10] [&:fullscreen]:bg-base-100 [&.is-expandido]:fixed [&.is-expandido]:inset-0 [&.is-expandido]:z-[950] [&.is-expandido]:aspect-auto [&.is-expandido]:bg-base-100">
    {typeof poster === "string" ? (
      <img class={posterClases} src={poster} alt={alt} />
    ) : (
      <Image
        class={posterClases}
        src={poster}
        alt={alt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 760px) 90vw, 690px"
      />
    )}
    <button
      class="model-3d-cargar button absolute bottom-3 left-1/2 -translate-x-1/2 whitespace-nowrap max-tablet:bottom-2 max-tablet:min-h-[44px] max-tablet:px-4 max-tablet:py-2"
      type="button"
      hidden
    >
      {pesado ? `Ver el modelo 3D · ${megas} MB` : "Ver en 3D"}
    </button>
    <div
      class="model-3d-progreso absolute inset-0 z-[5] flex flex-col items-center justify-center gap-3 bg-base-100/95 px-4 text-center font-bold text-primary max-tablet:gap-2"
      hidden
    >
      <div class="model-3d-progreso-loader aspect-square h-[62%] max-h-[300px]" aria-hidden="true"></div>
      <p class="model-3d-progreso-texto m-0 text-xl max-tablet:text-base celular:text-[0.95rem]" aria-hidden="true"></p>
      <p class="model-3d-progreso-aviso sr-only" aria-live="polite"></p>
      <div
        class="model-3d-progreso-pista h-3 w-[min(420px,78%)] overflow-hidden rounded-full bg-base-300 max-tablet:h-2.5"
        role="progressbar"
        aria-label="Descarga del modelo 3D"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        hidden
      >
        <div class="model-3d-progreso-barra h-full w-0 bg-secondary"></div>
      </div>
    </div>
    <button
      class="model-3d-completa absolute top-3 right-3 z-10 grid size-11 place-items-center rounded-[4px] border border-base-300 bg-base-100/90 text-primary hover:bg-base-200 [&[aria-pressed=true]_.icono-expandir]:hidden [&[aria-pressed=false]_.icono-reducir]:hidden"
      type="button"
      aria-label="Ver en pantalla completa"
      aria-pressed="false"
      hidden
    >
      <span class="icono-expandir"><Icon name="expand" size={20} /></span>
      <span class="icono-reducir"><Icon name="collapse" size={20} /></span>
    </button>
  </div>
  <figcaption class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[0.72rem] text-base-content">
    <span class="font-bold tracking-[0.1em] uppercase">Modelo 3D</span>
    <span class="pointer-coarse:hidden">
      {recorrible ? "Arrastra para girar · Clic derecho para mover · Rueda para acercar" : "Arrastra para girar · Rueda para acercar"}
    </span>
    <span class="hidden pointer-coarse:inline">
      {recorrible ? "Desliza para girar · Dos dedos para mover y acercar" : "Desliza para girar · Pellizca para acercar"}
    </span>
  </figcaption>
</figure>

<script>
  import "../../scripts/propuestas/modelo-3d";
</script>
