---
import { Image } from "astro:assets";
import Icon from "../comun/Icon.astro";
import type { ProposalSite } from "../../lib/data/types";

type Props = ProposalSite;
const { url, title, description, logo, logoAnimado } = Astro.props;
const dominio = new URL(url).hostname;
---

<a
  class="group relative flex h-full flex-col overflow-hidden rounded-[10px] border-2 border-primary bg-base-100 text-center text-primary [box-shadow:0_6px_0_#06317614] [transition:transform_0.18s] hover:-translate-y-1"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${title}, ${dominio} (abre en otra pestaña)`}
>
  {/* Franja y festón en un solo SVG, con el patrón más alto que el dibujo: con escalas como 125 %, dos
      piezas separadas dejan ver un hilo entre ellas y asoma el borde de una segunda fila del patrón. */}
  <svg class="block h-[82px] w-full" aria-hidden="true">
    <pattern id="feston-toldo" y="64" width="28" height="40" patternUnits="userSpaceOnUse">
      <circle class="fill-accent stroke-primary" cx="14" cy="0" r="12.5" stroke-width="3" />
    </pattern>
    <rect width="100%" height="100%" fill="url(#feston-toldo)" />
    <rect class="fill-accent" width="100%" height="65" />
  </svg>
  <span class="absolute top-4 right-4"><Icon name="external" size={22} /></span>
  <span class="relative mx-auto -mt-[62px] grid size-[104px] place-items-center rounded-full border-[3px] border-primary bg-base-100">
    <Image class="h-[70px] w-auto" src={logo} alt="" />
    {logoAnimado && <span class="absolute inset-0 m-auto aspect-[5/6] h-[70px]" data-logo-animado={logoAnimado} hidden></span>}
  </span>
  <div class="flex flex-1 flex-col items-center px-8 pt-4 pb-8 max-tablet:px-5 max-tablet:pb-6">
    <h4 class="m-0 font-display text-[2.3rem] leading-[1.05] font-bold max-tablet:text-[2rem]">{title}</h4>
    <span class="mt-1.5 text-[0.95rem] font-medium text-neutral [overflow-wrap:anywhere]">{dominio}</span>
    <p class="mx-0 mt-4 mb-0 max-w-[420px] text-[1rem] leading-[1.75]">{description}</p>
    <span class="mt-auto pt-6 max-tablet:w-full">
      <span class="inline-flex min-h-11 items-center gap-2.5 rounded-full bg-campaign-red px-6 text-[0.9rem] font-bold text-primary-content group-hover:underline max-tablet:flex max-tablet:justify-center">
        Visitar el sitio <Icon name="external" size={18} />
      </span>
    </span>
  </div>
</a>

<script>
  import { reproducir, type Animacion } from "../../lib/comun/animaciones";

  for (const lienzo of document.querySelectorAll<HTMLElement>("[data-logo-animado]")) {
    const observador = new IntersectionObserver(async ([entrada]) => {
      if (!entrada.isIntersecting) return;
      observador.disconnect();
      lienzo.hidden = false;
      if (await reproducir(lienzo, lienzo.dataset.logoAnimado as Animacion)) lienzo.previousElementSibling!.classList.add("invisible");
      else lienzo.hidden = true;
    }, { rootMargin: "200px" });
    observador.observe(lienzo.parentElement!);
  }
</script>
