---
import { Image } from "astro:assets";
import logo from "../assets/logo.avif";
import Icon from "../components/Icon.astro";
import { contentRepository } from "../lib/data";
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/700.css";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Carlos Astudillo · San Lorenzo",
  description = "Conoce a Carlos Astudillo, candidato a la alcaldía de San Lorenzo por el Partido Social Cristiano, Lista 6. Propuestas y espacios de ciudadanía.",
} = Astro.props;
const current = Astro.url.pathname;
const proposals = await contentRepository.getProposals();
const citizenLinks = await contentRepository.getCitizenLinks();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#063176" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <title>{title}</title>
  </head>
  <body>
    <a
      class="fixed -top-[100px] left-5 z-[1000] p-[15px] bg-base-100 text-primary focus:top-3"
      href="#contenido"
    >
      Saltar al contenido
    </a>
    <div class="topbar">
      <div class="site-container topbar-inner">
        <span>
          <Icon name="location" size={14} /> San Lorenzo, Esmeraldas
        </span>
        <span>
          Partido Social Cristiano <b>LISTA 6</b>
        </span>
      </div>
    </div>
    <header class="site-header">
      <div class="site-container header-inner">
        <a class="brand" href="/" aria-label="Carlos Astudillo, inicio">
          <Image src={logo} alt="" width={68} height={58} fit="contain" />
          <span>
            CARLOS <strong>ASTUDILLO</strong>
            <small>ALCALDÍA DE SAN LORENZO</small>
          </span>
        </a>
        <a class="report-link" href="/ciudadania/alerta-ciudadana/">
          <Icon name="alert" size={19} />
          <span>Reportar daño</span>
        </a>
        <button
          class="menu-toggle"
          aria-label="Abrir menú"
          aria-controls="main-nav"
          aria-expanded="false"
        >
          <Icon name="menu" />
        </button>
        <nav id="main-nav" aria-label="Navegación principal">
          <a
            class:list={["nav-link", { active: current === "/" }]}
            href="/"
            aria-current={current === "/" ? "page" : undefined}
          >
            Inicio
          </a>
          <a
            class:list={[
              "nav-link",
              { active: current === "/acerca-de-nosotros/" },
            ]}
            href="/acerca-de-nosotros/"
          >
            Acerca de nosotros
          </a>
          <div class="nav-dropdown">
            <button
              class:list={[
                "nav-link",
                { active: current.startsWith("/propuestas/") },
              ]}
              aria-expanded="false"
              aria-controls="proposals-menu"
            >
              Propuestas <Icon name="chevron" size={14} />
            </button>
            <div
              id="proposals-menu"
              class="dropdown-panel proposals-menu"
              hidden
            >
              {proposals.map((p) => (
                <a href={`/propuestas/${p.slug}/`}>
                  <Icon name={p.icon} size={21} />
                  <span>{p.name}</span>
                </a>
              ))}
            </div>
          </div>
          <div class="nav-dropdown">
            <button
              class:list={[
                "nav-link",
                { active: current.startsWith("/ciudadania/") },
              ]}
              aria-expanded="false"
              aria-controls="citizen-menu"
            >
              Ciudadanía <Icon name="chevron" size={14} />
            </button>
            <div id="citizen-menu" class="dropdown-panel" hidden>
              {citizenLinks.map((p) => (
                <a href={`/ciudadania/${p.slug}/`}>
                  <Icon name={p.icon} size={21} />
                  {p.name}
                </a>
              ))}
            </div>
          </div>
          <a class="nav-link" href="/#contacto">
            Contáctanos
          </a>
        </nav>
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <footer>
      <div class="site-container footer-top">
        <a class="footer-brand" href="/">
          CARLOS ASTUDILLO<span>Por ti, San Lorenzo.</span>
        </a>
        <p>
          Candidato a la alcaldía de San Lorenzo
          <br />
          Partido Social Cristiano · Lista 6
        </p>
        <a href="/#contacto">
          Contáctanos <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="site-container footer-bottom">
        <span>© {new Date().getFullYear()} Carlos Astudillo</span>
        <span>Por ti, San Lorenzo.</span>
      </div>
    </footer>
    <button
      class="access-toggle"
      aria-label="Herramientas de accesibilidad"
      aria-expanded="false"
      aria-controls="access-panel"
    >
      <Icon name="person" size={24} />
    </button>
    <aside
      id="access-panel"
      class="access-panel"
      aria-label="Herramientas de accesibilidad"
      hidden
    >
      <div class="panel-title">
        <strong>Accesibilidad</strong>
        <button class="access-close" aria-label="Cerrar accesibilidad">
          <Icon name="close" size={20} />
        </button>
      </div>
      <button data-text-step="1">
        Aumentar texto <span>A+</span>
      </button>
      <button data-text-step="-1">
        Disminuir texto <span>A-</span>
      </button>
      <button data-setting="grayscale" aria-pressed="false">
        Escala de grises <span>◍</span>
      </button>
      <button data-setting="high-contrast" aria-pressed="false">
        Alto contraste <span>◐</span>
      </button>
      <button data-setting="negative-contrast" aria-pressed="false">
        Contraste negativo <span>◑</span>
      </button>
      <button data-setting="light-bg" aria-pressed="false">
        Fondo claro <span>▢</span>
      </button>
      <button data-setting="underline-links" aria-pressed="false">
        Subrayar enlaces <span>U</span>
      </button>
      <button data-setting="readable-font" aria-pressed="false">
        Fuente legible <span>Aa</span>
      </button>
      <button data-setting="reduce-motion" aria-pressed="false">
        Reducir movimiento <span>Ⅱ</span>
      </button>
      <button class="access-reset">Restablecer ajustes</button>
    </aside>
    <script src="../scripts/layout.ts"></script>
  </body>
</html>
