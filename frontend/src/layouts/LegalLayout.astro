---
import Layout from "./Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
interface Props {
  title: string;
  description: string;
  /** Fecha de la última versión de ese documento, p. ej. «5 de octubre de 2026». */
  actualizado: string;
}
const { title, description, actualizado } = Astro.props;
---

<Layout title={`${title} · Carlos Astudillo`} description={description} contentClass="bg-base-100">
  <Breadcrumb items={[{ label: "Inicio", href: "/" }, { label: title }]} />
  <article class="site-container max-w-[850px] pt-[30px] pb-14 max-tablet:pt-6 max-tablet:pb-10 [&_h2]:mt-8 [&_h2]:mb-4 [&_h2]:font-sans [&_h2]:font-medium [&_h2]:text-[1.8rem] [&_h2]:leading-tight [&_strong]:font-normal [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-2 [&_li]:leading-[1.75] [&_a]:underline [&_a]:underline-offset-4 [&_a]:[overflow-wrap:anywhere]">
    <span class="eyebrow font-normal">INFORMACIÓN LEGAL</span>
    <h1 class="mt-3 mb-4 font-sans font-medium text-[clamp(2.5rem,4vw,3.75rem)] max-tablet:text-[2.5rem]">{title}</h1>
    <p class="mb-6 text-[0.8rem]">Última actualización: {actualizado}.</p>
    <slot />
  </article>
</Layout>
