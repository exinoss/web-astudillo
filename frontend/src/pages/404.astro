---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada · Carlos Astudillo">
  <section class="site-container py-24 max-[1190px]:py-[70px] max-[760px]:py-14 error-page">
    <span class="eyebrow flex items-center gap-3 text-[0.69rem] font-bold tracking-[0.15em] leading-[1.6]">
      ERROR 404
    </span>
    <h1>Esta página no está aquí.</h1>
    <p>Puedes volver al inicio para encontrar lo que buscas.</p>
    <a
      class="button inline-flex justify-center items-center gap-7 min-h-[50px] py-[15px] px-6 border-0 text-[0.85rem] font-bold rounded-[3px] transition duration-[180ms] hover:-translate-y-0.5 bg-primary text-primary-content hover:bg-neutral"
      href="/"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
