---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Editable from "../../components/Editable.astro";
import Icon from "../../components/Icon.astro";
---

<Layout title="Conoce más sobre Carlos · Carlos Astudillo" description="Conoce más sobre Carlos Astudillo, explora sus propuestas y comparte ideas para San Lorenzo.">
  <Breadcrumb
    items={[
      { label: "Inicio", href: "/" },
      { label: "Acerca de nosotros", href: "/acerca-de-nosotros/" },
      { label: "Conoce más sobre Carlos" },
    ]}
  />
  <section class="site-container max-w-[850px] pt-[30px] pb-14 max-tablet:pt-5 max-tablet:pb-10">
    <Editable clave="conoce-mas.antetitulo" class="eyebrow" />
    <Editable as="h1" clave="conoce-mas.titulo" class="mt-3 mb-6 text-[clamp(2.5rem,4vw,3.75rem)] max-tablet:text-[2.5rem]" />
    <Editable as="p" clave="conoce-mas.texto" />
    <a class="button" href="/#propuestas">
      Ver propuestas <Icon name="arrow" size={18} />
    </a>
  </section>
</Layout>
