---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { contentRepository } from "../../lib/data";
import type { CitizenLink, Proposal } from "../../lib/data/types";

interface Props {
  item: CitizenLink;
  proposals: Proposal[];
}

export async function getStaticPaths() {
  const [citizenLinks, proposals] = await Promise.all([
    contentRepository.getCitizenLinks(),
    contentRepository.getProposals(),
  ]);
  return citizenLinks.map((p) => ({
    params: { slug: p.slug },
    props: { item: p, proposals },
  }));
}
const { item, proposals } = Astro.props;
const alert = item.slug === "alerta-ciudadana";
const chat = item.slug === "chat";
---

<Layout title={`${item.name} · Carlos Astudillo`}>
  <div class="site-container breadcrumb">
    <a href="/">Inicio</a>
    <span>/</span>Ciudadanía<span>/</span>
    {item.name}
  </div>
  <section class="detail-banner">
    <div class="site-container">
      <span class="eyebrow flex items-center gap-3 text-[0.69rem] font-bold tracking-[0.15em] leading-[1.6]">
        CIUDADANÍA · TU VOZ CUENTA
      </span>
      <div class="detail-title">
        <h1>{item.name}</h1>
        <Icon name={item.icon} size={64} />
      </div>
      <p class="lead">{item.description}</p>
    </div>
  </section>
  <section class="site-container citizen-page py-24 max-[1190px]:py-[70px] max-[760px]:py-14">
    <div class="citizen-explanation">
      <span class="eyebrow flex items-center gap-3 text-[0.69rem] font-bold tracking-[0.15em] leading-[1.6]">
        UN ESPACIO PARA TI
      </span>
      <h2>
        {chat
          ? "¿Qué quieres conocer?"
          : alert
            ? "Cuéntanos lo que pasa."
            : "Las ideas empiezan contigo."}
      </h2>
      <p>
        {chat
          ? "Selecciona un tema para encontrar información del sitio."
          : alert
            ? "Indica el barrio, describe el daño y adjunta una foto para ayudarnos a entender la situación."
            : "Elige un tema y comparte tu sugerencia de forma clara."}
      </p>
      {alert && (
        <p class="content-note">
          Este espacio no recibe emergencias ni genera reportes oficiales.
        </p>
      )}
    </div>
    {chat ? (
      <div class="chat-box">
        <div class="chat-header">
          <Icon name="chat" />
          <div>
            <strong>Orientación ciudadana</strong>
            <small>Información y orientación</small>
          </div>
        </div>
        <div
          class="chat-messages"
          role="log"
          aria-live="polite"
          aria-relevant="additions"
          aria-label="Conversación"
        >
          <div class="chat-message">
            Hola. Puedes consultar las propuestas, conocer a Carlos o encontrar
            la sección de contacto.
          </div>
        </div>
        <div class="chat-options">
          <button data-chat="propuestas">Ver propuestas</button>
          <button data-chat="carlos">Conocer a Carlos</button>
          <button data-chat="contacto">Contacto</button>
        </div>
        <form id="chat-form">
          <label class="sr-only" for="chat-input">
            Escribe tu consulta
          </label>
          <input
            id="chat-input"
            placeholder="Escribe tu consulta…"
            maxlength="300"
            required
            autocomplete="off"
          />
          <button
            class="button inline-flex justify-center items-center gap-7 min-h-[50px] py-[15px] px-6 border-0 text-[0.85rem] font-bold rounded-[3px] transition duration-[180ms] hover:-translate-y-0.5 bg-primary text-primary-content hover:bg-neutral"
            aria-label="Enviar consulta"
          >
            <Icon name="arrow" size={20} />
          </button>
        </form>
      </div>
    ) : (
      <form class="citizen-form">
        <div class="form-heading">
          <h3>{alert ? "Nueva alerta" : "Tu sugerencia"}</h3>
          <span>* Campos obligatorios</span>
        </div>
        <label for="name">
          Nombre <span>(opcional)</span>
        </label>
        <input
          id="name"
          name="nombre"
          autocomplete="given-name"
          maxlength="80"
          placeholder="¿Cómo te llamas?"
        />
        <label for="topic">{alert ? "Sector o barrio *" : "Tema *"}</label>
        {alert ? (
          <input
            id="topic"
            name="sector"
            placeholder="Indica el sector"
            required
            maxlength="120"
          />
        ) : (
          <select id="topic" name="tema" required>
            <option value="">Selecciona un tema</option>
            {proposals.map((p) => (
              <option value={p.slug}>{p.name}</option>
            ))}
            <option value="otro">Otra idea</option>
          </select>
        )}
        {alert && (
          <>
            <label for="reference">
              Dirección o punto de referencia <span>(opcional)</span>
            </label>
            <input
              id="reference"
              name="referencia"
              maxlength="180"
              placeholder="Por ejemplo: frente al parque, calle principal"
            />
          </>
        )}
        <label for="message">
          {alert ? "¿Qué está ocurriendo? *" : "¿Qué te gustaría proponer? *"}
        </label>
        <textarea
          id="message"
          name="mensaje"
          rows="5"
          minlength="15"
          maxlength="1500"
          required
          placeholder={
            alert
              ? "Describe la situación y dónde ocurre…"
              : "Cuéntanos tu idea…"
          }
        ></textarea>
        <div class="form-hint">
          Mínimo 15 caracteres. Evita incluir datos sensibles.
        </div>
        {alert && (
          <div class="photo-field">
            <label for="damage-photo">
              Foto del daño <span>(opcional)</span>
            </label>
            <p id="photo-help">
              Adjunta una foto de tu galería o usa la cámara de tu teléfono.
              JPG, PNG o WebP · máximo 10 MB.
            </p>
            <input
              type="file"
              id="damage-photo"
              name="foto"
              accept="image/jpeg,image/png,image/webp"
              aria-describedby="photo-help photo-error"
            />
            <p id="photo-error" role="alert" hidden></p>
            <div class="photo-preview" hidden>
              <img alt="Vista previa de la foto del daño" />
              <div>
                <span class="photo-name"></span>
                <button type="button" class="photo-remove">
                  Quitar foto
                </button>
              </div>
            </div>
          </div>
        )}
        <button
          class="button inline-flex justify-center items-center gap-7 min-h-[50px] py-[15px] px-6 border-0 text-[0.85rem] font-bold rounded-[3px] transition duration-[180ms] hover:-translate-y-0.5 bg-primary text-primary-content hover:bg-neutral"
          type="submit"
        >
          Enviar {alert ? "alerta" : "sugerencia"}{" "}
          <Icon name="arrow" size={18} />
        </button>
        <p class="form-status" role="status" hidden></p>
      </form>
    )}
  </section>
  <script src="../../scripts/citizen.ts"></script>
</Layout>
