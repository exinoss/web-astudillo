---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/comun/Breadcrumb.astro";
import DetailBanner from "../../components/comun/DetailBanner.astro";
import Alerta from "../../components/ciudadania/Alerta.astro";
import Chat from "../../components/ciudadania/Chat.astro";
import Sugerencia from "../../components/ciudadania/Sugerencia.astro";
import { contentRepository } from "../../lib/data";
import type { CitizenLink, Proposal } from "../../lib/data/types";

interface Props {
  item: CitizenLink;
  proposals: Proposal[];
  quickReplies: string[];
}

export async function getStaticPaths() {
  const [citizenLinks, proposals, quickReplies] = await Promise.all([
    contentRepository.getCitizenLinks(),
    contentRepository.getProposals(),
    contentRepository.getChatQuickReplies(),
  ]);
  return citizenLinks.map((p) => ({
    params: { slug: p.slug },
    props: { item: p, proposals, quickReplies },
  }));
}
const { item, proposals, quickReplies } = Astro.props;
---

<Layout title={`${item.name} · Carlos Astudillo`} description={item.description}>
  <Breadcrumb
    items={[
      { label: "Inicio", href: "/" },
      { label: "Ciudadanía" },
      { label: item.name },
    ]}
  />
  <DetailBanner
    eyebrow="CIUDADANÍA · TU VOZ CUENTA"
    title={item.name}
    icon={item.icon}
    iconSize={64}
    lead={item.description}
    claves={{title:`ciudadania.${item.slug}.nombre`,lead:`ciudadania.${item.slug}.descripcion`}}
  />
  {item.slug === "alerta-ciudadana" ? <Alerta /> : item.slug === "chat" ? <Chat quickReplies={quickReplies} /> : <Sugerencia proposals={proposals} />}
</Layout>
