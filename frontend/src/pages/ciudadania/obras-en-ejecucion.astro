---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import DetailBanner from "../../components/DetailBanner.astro";
import EvidenceCarousel from "../../components/EvidenceCarousel.astro";
import Editable from "../../components/Editable.astro";
import { contentRepository } from "../../lib/data";
import { texto } from "../../lib/contenido";
import { STAGE_NAMES, workProgress, type WorkStage } from "../../lib/obras";

const [works, proposals] = await Promise.all([
  contentRepository.getWorks(),
  contentRepository.getProposals(),
]);
const obras = works.flatMap((work) => {
  const proposal = proposals.find((p) => p.slug === work.proposalSlug);
  return proposal ? [{ ...work, proposal, ...workProgress(work.milestones) }] : [];
});
const [antetitulo, titulo, intro] = await Promise.all([texto("obras.antetitulo"), texto("obras.titulo"), texto("obras.intro")]);

const etapas: Record<WorkStage, string> = {
  "por-iniciar": "border border-base-300 text-primary",
  "en-ejecucion": "bg-secondary text-primary",
  terminada: "bg-primary text-primary-content",
};
// Fecha fija sin zona horaria: `new Date("AAAA-MM-DD")` se interpreta en UTC y en Ecuador mostraría el día anterior.
const fecha = new Intl.DateTimeFormat("es-EC", { dateStyle: "long", timeZone: "UTC" });
---

<Layout title="Obras en ejecución · Carlos Astudillo">
  <Breadcrumb
    items={[
      { label: "Inicio", href: "/" },
      { label: "Ciudadanía" },
      { label: "Obras en ejecución" },
    ]}
  />
  <DetailBanner
    eyebrow={antetitulo}
    title={titulo}
    icon="obras"
    iconSize={64}
    lead={intro}
    claves={{ eyebrow: "obras.antetitulo", title: "obras.titulo", lead: "obras.intro" }}
  />
  <section class="site-container pt-8 pb-14 max-tablet:pt-6 max-tablet:pb-10">
    <Editable as="p" clave="obras.nota" class="content-note mt-0 mb-5" />
    <div class="flex flex-col gap-[30px] max-tablet:gap-10">
      {obras.map((obra) => {
        const etapa = { nombre: STAGE_NAMES[obra.stage], clases: etapas[obra.stage] };
        const siguiente = obra.milestones.findIndex((hito) => !hito.done);
        return (
          <div class="grid grid-cols-2 gap-[18px] max-tablet:grid-cols-1 max-tablet:gap-3">
          <article class="obra flex flex-col rounded-[4px] bg-base-100 p-7 text-primary [border-right:1px_solid_#06317630] [border-bottom:1px_solid_#06317630] [border-left:1px_solid_#06317630] [border-top:4px_solid_var(--color-secondary)] [box-shadow:0_4px_14px_#06317608] max-desktop-sm:p-[23px] max-tablet:px-4 max-tablet:py-5">
            <div class="mb-5 flex items-center justify-between gap-3">
              <span class="flex items-center gap-2.5">
                <Icon name={obra.proposal.icon} size={30} />
                <span class="text-[0.64rem] font-bold tracking-[0.12em] text-neutral uppercase">
                  {obra.proposal.label}
                </span>
              </span>
              <span class:list={["rounded-full px-3 py-1 text-[0.66rem] font-bold tracking-[0.08em] whitespace-nowrap uppercase", etapa.clases]}>
                {etapa.nombre}
              </span>
            </div>
            <h2 class="m-0 mb-4 text-[2rem] leading-[1.05] max-tablet:text-[1.7rem]">
              {obra.proposal.name}
            </h2>
            <div class="mb-1.5 flex items-baseline justify-between text-[0.8rem] font-bold">
              <span>Avance</span>
              <span class="font-display text-[1.5rem] leading-none">{obra.percent} %</span>
            </div>
            <div
              class="h-2.5 overflow-hidden rounded-full bg-[#06317618]"
              role="progressbar"
              aria-label={`Avance de ${obra.proposal.name}`}
              aria-valuenow={obra.percent}
              aria-valuemin="0"
              aria-valuemax="100"
            >
              <div class="h-full rounded-full bg-neutral" style={`width: ${obra.percent}%`} />
            </div>
            <p class="mt-4 mb-5 text-[0.85rem] leading-[1.6]">{obra.note}</p>
            <ol class="m-0 mb-6 flex list-none flex-col gap-2.5 p-0" aria-label="Hitos de la obra">
              {obra.milestones.map((hito, i) => {
                const actual = i === siguiente && obra.stage !== "por-iniciar";
                return (
                  <li class="flex items-center gap-3 text-[0.85rem]">
                    <span
                      class:list={[
                        "grid size-[22px] shrink-0 place-items-center rounded-full",
                        hito.done
                          ? "bg-neutral text-neutral-content"
                          : actual
                            ? "border-2 border-secondary"
                            : "border-2 border-base-300",
                      ]}
                      aria-hidden="true"
                    >
                      {hito.done && <Icon name="check" size={13} />}
                    </span>
                    <span class:list={[hito.done ? "" : actual ? "font-bold" : "text-base-content/70"]}>
                      {hito.name}
                    </span>
                    <span class="sr-only">
                      {hito.done ? "(completado)" : actual ? "(en curso)" : "(pendiente)"}
                    </span>
                  </li>
                );
              })}
            </ol>
            <div class="mt-auto flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-t-base-300 pt-4 text-[0.75rem]">
              <span>Actualizado el {fecha.format(new Date(obra.updatedAt))}</span>
              <a
                class="inline-flex min-h-11 items-center gap-2 font-bold text-neutral hover:underline"
                href={`/propuestas/${obra.proposal.slug}/`}
              >
                Ver propuesta <Icon name="arrow" size={17} />
              </a>
            </div>
          </article>
          <EvidenceCarousel id={obra.proposal.slug} evidence={obra.evidence} name={obra.proposal.name} />
          </div>
        );
      })}
    </div>
  </section>
</Layout>
