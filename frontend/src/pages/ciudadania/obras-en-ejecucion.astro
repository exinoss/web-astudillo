---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import DetailBanner from "../../components/DetailBanner.astro";
import EvidenceCarousel from "../../components/EvidenceCarousel.astro";
import ObraProgreso from "../../components/ObraProgreso.astro";
import Editable from "../../components/Editable.astro";
import { contentRepository } from "../../lib/data";
import { texto } from "../../lib/contenido";

const [works, proposals] = await Promise.all([
  contentRepository.getWorks(),
  contentRepository.getProposals(),
]);
const obras = works.flatMap((work) => {
  const proposal = proposals.find((p) => p.slug === work.proposalSlug);
  return proposal ? [{ ...work, proposal }] : [];
});
const [antetitulo, titulo, intro] = await Promise.all([texto("obras.antetitulo"), texto("obras.titulo"), texto("obras.intro")]);
---

<Layout title="Obras en ejecución · Carlos Astudillo" description="Consulta los avances, etapas y fotografías de las obras asociadas a las propuestas para San Lorenzo.">
  <Breadcrumb
    items={[
      { label: "Inicio", href: "/" },
      { label: "Ciudadanía" },
      { label: "Obras en ejecución" },
    ]}
  />
  <DetailBanner
    eyebrow={antetitulo}
    title={titulo}
    icon="obras"
    iconSize={64}
    lead={intro}
    claves={{ eyebrow: "obras.antetitulo", title: "obras.titulo", lead: "obras.intro" }}
  />
  <section class="site-container pt-8 pb-14 max-tablet:pt-6 max-tablet:pb-10">
    <Editable as="p" clave="obras.nota" class="content-note mt-0 mb-5" />
    <div class="flex flex-col gap-[30px] max-tablet:gap-10">
      {obras.map((obra) => (
        <div class="grid grid-cols-2 gap-[18px] max-tablet:grid-cols-1 max-tablet:gap-3">
          <ObraProgreso work={obra} proposal={obra.proposal} />
          <EvidenceCarousel id={obra.proposal.slug} evidence={obra.evidence} name={obra.proposal.name} />
        </div>
      ))}
    </div>
  </section>
</Layout>
