---
import AccountShell from '../../components/cuenta/AccountShell.astro';
import AccountCard from '../../components/cuenta/AccountCard.astro';
import AccountStatus from '../../components/cuenta/AccountStatus.astro';
import EnlaceCuenta from '../../components/cuenta/EnlaceCuenta.astro';
---

<AccountShell title="Termina de entrar" lead="Un paso más para acceder a tu cuenta.">
  <div class="mx-auto max-w-[560px]">
    <AccountCard heading="Acceso por correo" description="Comprobaremos el enlace recibido en tu correo.">
      <AccountStatus />
      <EnlaceCuenta href="/cuenta/" class="mt-5 text-[0.82rem]">Volver al acceso</EnlaceCuenta>
    </AccountCard>
  </div>
  <script src="../../scripts/cuenta/acceso.ts"></script>
</AccountShell>
