---
import AccountShell from '../../components/cuenta/AccountShell.astro';
import AccountCard from '../../components/cuenta/AccountCard.astro';
import AccountField from '../../components/cuenta/AccountField.astro';
import { LARGOS } from '../../../../backend/src/contracts/limites';
import AccountStatus from '../../components/cuenta/AccountStatus.astro';
import EnlaceCuenta from '../../components/cuenta/EnlaceCuenta.astro';
---

<AccountShell title="Recupera el acceso" lead="Te enviaremos un enlace para elegir una nueva contraseña.">
  <div class="mx-auto max-w-[560px]">
    <AccountCard heading="Recibir instrucciones" description="Escribe el correo de tu cuenta. Si tiene acceso por contraseña, enviaremos un enlace válido por 30 minutos.">
      <AccountStatus />
      <form id="recovery-form" novalidate>
        <AccountField id="recovery-email" name="correo" label="Correo electrónico" type="email" placeholder="nombre@ejemplo.com" autocomplete="email" required maxLength={LARGOS.cuenta.correo} />
        <button type="submit" class="button w-full">Enviar instrucciones</button>
      </form>
      <p class="m-0 mt-5 text-center text-sm text-muted">¿La recordaste? <EnlaceCuenta href="/cuenta/" class="font-bold text-primary">Inicia sesión</EnlaceCuenta></p>
    </AccountCard>
  </div>
  <script src="../../scripts/cuenta/recuperar.ts"></script>
</AccountShell>
