---
import AccountShell from '../../components/cuenta/AccountShell.astro';
import AccountCard from '../../components/cuenta/AccountCard.astro';
import AccountField from '../../components/cuenta/AccountField.astro';
import { LARGOS } from '../../../../backend/src/contracts/limites';
import AccountStatus from '../../components/cuenta/AccountStatus.astro';
import EnlaceCuenta from '../../components/cuenta/EnlaceCuenta.astro';
---

<AccountShell title="Nueva contraseña" lead="Elige una contraseña para volver a entrar.">
  <div class="mx-auto max-w-[560px]">
    <AccountCard heading="Restablecer acceso" description="El enlace se puede usar una sola vez. Al guardar, cerraremos las sesiones abiertas.">
      <AccountStatus />
      <form id="reset-form" data-new-password="contrasenia" novalidate>
        <AccountField id="reset-password" name="contrasenia" label="Nueva contraseña" type="password" placeholder="Escribe tu contraseña" autocomplete="new-password" hint="Mínimo 6 caracteres; incluye una letra, un número y un símbolo." required maxLength={LARGOS.cuenta.contrasenia} />
        <AccountField id="reset-confirm" name="confirmarContrasenia" label="Repite la nueva contraseña" type="password" placeholder="Escribe tu contraseña" autocomplete="new-password" required maxLength={LARGOS.cuenta.contrasenia} />
        <button type="submit" class="button w-full">Guardar contraseña</button>
      </form>
      <div id="reset-done" hidden><EnlaceCuenta href="/cuenta/" class="mt-5 text-[0.82rem]">Ir al acceso</EnlaceCuenta></div>
      <EnlaceCuenta href="/cuenta/recuperar/" class="mt-5 text-[0.82rem]">Solicitar otro enlace</EnlaceCuenta>
    </AccountCard>
  </div>
  <script src="../../scripts/cuenta/restablecer.ts"></script>
</AccountShell>
