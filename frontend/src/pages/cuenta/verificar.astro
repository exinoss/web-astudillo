---
import AccountShell from '../../components/cuenta/AccountShell.astro';
import AccountCard from '../../components/cuenta/AccountCard.astro';
import AccountStatus from '../../components/cuenta/AccountStatus.astro';
import EnlaceCuenta from '../../components/cuenta/EnlaceCuenta.astro';
---

<AccountShell title="Confirma tu correo" lead="Un paso más para activar tu cuenta.">
  <div class="mx-auto max-w-[560px]">
    <AccountCard heading="Verificación" description="Comprobaremos el enlace recibido en tu correo.">
      <AccountStatus />
      <div id="verify-done" hidden><EnlaceCuenta href="/cuenta/" class="text-[0.82rem]">Ir al acceso</EnlaceCuenta></div>
      <EnlaceCuenta href="/cuenta/registro/" class="mt-5 text-[0.82rem]">Solicitar otro enlace</EnlaceCuenta>
    </AccountCard>
  </div>
  <script src="../../scripts/cuenta/verificar.ts"></script>
</AccountShell>
