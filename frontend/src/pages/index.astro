---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/comun/Icon.astro";
import Editable from "../components/comun/Editable.astro";
import { Image } from "astro:assets";
import cover from "../assets/portada.jpg";
import carlos from "../assets/carlos-vertical.png";
import carlos2 from "../assets/carlos2.jpg";
import carlos3 from "../assets/carlos3.jpg";
import { contentRepository } from "../lib/data";
import { statsRepository } from "../lib/data/stats";
import { enlaceRed, type TextKey } from "../lib/comun/contenido";
import { enlaceRedValido, REDES, type RedSocial, usuarioRed } from "../lib/comun/contenido/redes";

const proposals = await contentRepository.getProposals();
const citizenLinks = await contentRepository.getCitizenLinks();
const textos = await contentRepository.getTexts();
const cifras = await statsRepository.current();
const formato = new Intl.NumberFormat("es-EC");
const CIFRAS = [
  { cifra: "visitas", clave: "inicio.cifras.visitas" },
  { cifra: "voces", clave: "inicio.cifras.voces" },
] as const;
const FONDOS: Record<RedSocial, string> = {
  facebook: "bg-[#1877f2]",
  instagram: "bg-[linear-gradient(45deg,#f58529,#dd2a7b_50%,#8134af_75%,#515bd4)]",
  tiktok: "bg-[#111]",
};
// Una red sin enlace válido (por ejemplo, Instagram antes de añadirlo en el panel) no se muestra.
const contactos = [
  ...(Object.keys(FONDOS) as RedSocial[])
    .filter((red) => enlaceRedValido(red, textos[REDES[red].clave] ?? ""))
    .map((red) => ({
      red, nombre: REDES[red].nombre, url: textos[REDES[red].clave], usuario: usuarioRed(red, textos[REDES[red].clave]),
      fondo: FONDOS[red], clave: `inicio.contacto.${red}.texto` as TextKey, etiqueta: `${REDES[red].nombre} de Carlos Astudillo (abre en otra pestaña)`,
    })),
  {
    red: "whatsapp", nombre: "WhatsApp", url: await enlaceRed("whatsapp"), usuario: "Mensaje directo",
    fondo: "bg-[#25d366]", clave: "inicio.contacto.whatsapp.texto" as TextKey, etiqueta: "Escribir por WhatsApp a Carlos Astudillo (abre en otra pestaña)",
  },
];
---

<Layout>
  <h1 class="sr-only">
    Carlos Astudillo, candidato a la alcaldía de San Lorenzo
  </h1>
  <section
    class="hero"
    aria-label="Presentación de Carlos Astudillo"
    aria-roledescription="carrusel"
  >
    <div class="hero-slides relative bg-accent">
      <div
        class="relative aspect-[1947/741] w-full max-h-[680px] overflow-hidden min-wide:max-h-[740px] max-tablet:aspect-[4/3] max-tablet:max-h-none"
        data-slide="0"
        role="group"
        aria-roledescription="diapositiva"
        aria-label="1 de 2"
      >
        <Image
          class="h-full w-full object-cover max-tablet:absolute max-tablet:object-[100%_center]"
          src={cover}
          alt="Carlos Astudillo, PSC. La nueva historia. Creo en una ciudad donde el progreso no sea privilegio de pocos, sino derecho de todos."
          widths={[640, 960, 1440, 1947]}
          sizes="100vw"
          width={1947}
          height={741}
          loading="eager"
          fetchpriority="high"
          quality={85}
        />
        <div class="hidden max-tablet:absolute max-tablet:inset-y-0 max-tablet:right-auto max-tablet:left-0 max-tablet:flex max-tablet:w-[48%] max-tablet:flex-col max-tablet:justify-center max-tablet:bg-accent max-tablet:pt-6 max-tablet:pr-0 max-tablet:pb-5 max-tablet:pl-5">
          <Editable clave="inicio.carrusel.antetitulo" class="max-tablet:text-[0.56rem] max-tablet:font-bold max-tablet:tracking-[0.08em]" />
          <Editable as="h2" clave="inicio.carrusel.titulo" class="max-tablet:mx-0 max-tablet:mt-[15px] max-tablet:mb-[18px] max-tablet:text-[clamp(2rem,8vw,3.6rem)]" />
          <Editable as="p" clave="inicio.carrusel.texto" class="max-tablet:m-0 max-tablet:text-[0.67rem] max-tablet:leading-[1.6] max-tablet:text-primary" />
        </div>
      </div>
      <div
        class="relative aspect-[1947/741] w-full max-h-[680px] overflow-hidden bg-primary text-primary-content min-wide:max-h-[740px] max-tablet:aspect-[4/3] max-tablet:max-h-none"
        data-slide="1"
        role="group"
        aria-roledescription="diapositiva"
        aria-label="2 de 2"
        hidden
      >
        <div class="alternate-inner site-container flex h-full items-center justify-between max-tablet:w-full max-tablet:pl-5">
          <div class="py-[25px] max-tablet:w-[48%] max-tablet:py-2.5">
            <Editable clave="inicio.carrusel-2.antetitulo" class="eyebrow max-tablet:text-[0.48rem] max-tablet:tracking-[0.08em]" />
            <h2 class="mx-0 mt-[15px] mb-6 text-[clamp(2rem,5.7vw,6rem)] max-tablet:mt-2.5 max-tablet:mb-[15px] max-tablet:text-[clamp(2rem,7vw,3.5rem)]">
              <Editable clave="inicio.carrusel-2.titulo" />
              <br />
              <Editable as="em" clave="inicio.carrusel-2.destacado" class="text-accent not-italic" />
            </h2>
            <a
              href="/acerca-de-nosotros/"
              class="button button-light max-tablet:min-h-10 max-tablet:gap-2.5 max-tablet:p-2.5 max-tablet:text-[0.62rem]"
            >
              Conoce a Carlos <Icon name="arrow" size={18} />
            </a>
          </div>
          <Image
            class="h-full w-[47%] object-cover object-center max-tablet:w-[49%]"
            src={carlos}
            alt="Retrato de Carlos Astudillo"
            width={620}
            height={620}
            loading="lazy"
          />
        </div>
      </div>
      {/* En escritorio las flechas quedan a los lados; en móvil se unen a los puntos para no tapar el texto. */}
      <div class="carousel-controls pointer-events-none absolute inset-0 flex items-end justify-center pb-4 max-tablet:pb-2.5">
        <div
          class="pointer-events-auto flex items-center gap-2.5 rounded-full bg-base-100/85 px-3 py-2 max-tablet:gap-3 max-tablet:px-2 max-tablet:py-1"
          role="group"
          aria-label="Controles del carrusel"
        >
          <button class="slide-prev left-5 pointer-events-auto absolute top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-primary/65 text-primary-content hover:bg-primary max-tablet:relative max-tablet:inset-x-auto max-tablet:top-auto max-tablet:size-8 max-tablet:translate-y-0 max-tablet:bg-transparent max-tablet:text-primary max-tablet:before:absolute max-tablet:before:-inset-1.5 max-tablet:before:content-[''] max-tablet:hover:bg-transparent" type="button" aria-label="Diapositiva anterior">
            <Icon name="chevronLeft" size={22} />
          </button>
          <button
            class="slide-dot relative grid h-[11px] before:absolute before:-inset-x-[5px] before:-inset-y-[17px] before:content-[''] max-tablet:before:-inset-x-1.5 min-h-[11px] w-[11px] place-items-center rounded-[50%] border-[1.5px] border-primary bg-transparent p-0 text-primary hover:border-accent hover:bg-accent [&.is-active]:w-7 [&.is-active]:rounded-[10px] [&.is-active]:bg-primary disabled:cursor-default disabled:opacity-65 max-tablet:h-2.5 max-tablet:min-h-2.5 max-tablet:w-2.5 is-active"
            type="button"
            aria-label="Ver diapositiva 1"
            aria-current="true"
          ></button>
          <button
            class="slide-dot relative grid h-[11px] before:absolute before:-inset-x-[5px] before:-inset-y-[17px] before:content-[''] max-tablet:before:-inset-x-1.5 min-h-[11px] w-[11px] place-items-center rounded-[50%] border-[1.5px] border-primary bg-transparent p-0 text-primary hover:border-accent hover:bg-accent [&.is-active]:w-7 [&.is-active]:rounded-[10px] [&.is-active]:bg-primary disabled:cursor-default disabled:opacity-65 max-tablet:h-2.5 max-tablet:min-h-2.5 max-tablet:w-2.5"
            type="button"
            aria-label="Ver diapositiva 2"
            aria-current="false"
          ></button>
          <button class="slide-next right-5 pointer-events-auto absolute top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full bg-primary/65 text-primary-content hover:bg-primary max-tablet:relative max-tablet:inset-x-auto max-tablet:top-auto max-tablet:size-8 max-tablet:translate-y-0 max-tablet:bg-transparent max-tablet:text-primary max-tablet:before:absolute max-tablet:before:-inset-1.5 max-tablet:before:content-[''] max-tablet:hover:bg-transparent" type="button" aria-label="Diapositiva siguiente">
            <Icon name="chevronRight" size={22} />
          </button>
        </div>
      </div>
    </div>
  </section>
  <section
    class="bg-primary text-primary-content"
    aria-label="Participación ciudadana"
  >
    <div class="site-container grid min-h-[150px] grid-cols-[1fr_1.2fr_1.2fr_1.2fr] items-center gap-[25px] max-nav:grid-cols-2 max-nav:gap-5 max-nav:py-[25px] max-tablet:grid-cols-1 max-tablet:gap-0 max-tablet:py-[30px]">
      <div class="max-nav:pl-2.5 max-tablet:pb-5 max-tablet:pl-0">
        <Editable clave="inicio.participa.antetitulo" class="eyebrow text-[0.53rem] text-accent max-nav:text-[0.6rem]" />
        <Editable as="h2" clave="inicio.participa.titulo" class="mt-1.5 mr-0 mb-0 text-[2.1rem] max-nav:text-[2.3rem] max-tablet:text-[2.4rem]" />
      </div>
      {[...citizenLinks]
        .sort(
          (a, b) =>
            Number(b.slug === "alerta-ciudadana") -
            Number(a.slug === "alerta-ciudadana"),
        )
        .map((p) => {
          const tone = { "alerta-ciudadana": "rojo", sugerencias: "amarillo" }[p.slug];
          return (
            <a
              class:list={[
                "citizen-link flex min-h-[70px] items-center gap-[15px] [transition:color_0.18s] max-desktop-sm:gap-2.5 max-tablet:min-h-[80px] max-tablet:gap-[18px]",
                tone === "rojo" && "rounded-[4px] bg-campaign-red p-[18px] text-primary-content hover:bg-[#b80e18] max-tablet:mb-2.5",
                tone === "amarillo" && "rounded-[4px] bg-accent p-[18px] text-primary hover:bg-base-100 hover:text-primary max-tablet:mb-2.5",
                !tone && "[border-left:1px_solid_#ffffff30] pl-6 hover:text-accent max-nav:pl-5 max-tablet:[border-left:0] max-tablet:[border-top:1px_solid_#ffffff30] max-tablet:py-[18px] max-tablet:pl-0",
              ]}
              href={`/ciudadania/${p.slug}/`}
            >
              <span
                class:list={[
                  "citizen-icon",
                  tone === "rojo" ? "text-primary-content" : tone ? "text-primary" : "text-accent",
                ]}
              >
                <Icon name={p.icon} size={26} />
              </span>
              <span>
                <strong class="block text-base">{p.name}</strong>
                <small
                  class:list={[
                    "mt-1.5 block max-w-[155px] text-[0.78rem] leading-[1.6] max-nav:max-w-none max-tablet:mt-1",
                    tone === "rojo" ? "text-primary-content" : tone ? "text-primary" : "text-footer-muted",
                  ]}
                >
                  {p.description}
                </small>
              </span>
              <Icon name="arrow" size={19} />
            </a>
          );
        })}
    </div>
  </section>
  <section class="about-section bg-secondary py-section">
    <div class="site-container grid max-w-[1120px] grid-cols-2 items-center gap-[100px] max-nav:gap-10 max-tablet:grid-cols-1 max-tablet:gap-[42px]">
      <div
        class="portrait-wrap profile-carousel"
        aria-roledescription="carrusel"
        aria-label="Carlos Astudillo"
      >
        <Image
          data-profile-image="0"
          class="is-active"
          src={carlos}
          alt="Carlos Astudillo. Respeto, coherencia y claridad. Por ti, San Lorenzo."
          widths={[400, 640, 850]}
          sizes="(max-width: 760px) 90vw, 40vw"
          loading="lazy"
        />
        <Image
          data-profile-image="1"
          src={carlos2}
          alt="Carlos Astudillo. Por ti, San Lorenzo."
          widths={[400, 640, 850]}
          sizes="(max-width: 760px) 90vw, 40vw"
          loading="lazy"
          hidden
        />
        <Image
          data-profile-image="2"
          src={carlos3}
          alt="Carlos Astudillo. Respeto, coherencia, claridad."
          widths={[400, 640, 850]}
          sizes="(max-width: 760px) 90vw, 40vw"
          loading="lazy"
          hidden
        />
        <div class="profile-glass-curtain" aria-hidden="true">
          <div class="profile-glass-veil"></div>
        </div>
        <div
          class="profile-dots"
          role="group"
          aria-label="Imágenes de Carlos Astudillo"
        >
          <button
            class="profile-dot is-active"
            type="button"
            aria-label="Ver imagen 1"
            aria-current="true"
          ></button>
          <button
            class="profile-dot"
            type="button"
            aria-label="Ver imagen 2"
            aria-current="false"
          ></button>
          <button
            class="profile-dot"
            type="button"
            aria-label="Ver imagen 3"
            aria-current="false"
          ></button>
        </div>
      </div>
      <div class="">
        <span class="eyebrow">
          <span class="short-line"></span> <Editable clave="inicio.conoce.antetitulo" />
        </span>
        <h2 class="mt-4 mb-5 text-[clamp(3rem,4.8vw,4.6rem)] max-nav:text-[3.3rem] max-tablet:text-[3.4rem]">
          <Editable clave="inicio.conoce.titulo" /> <Editable clave="inicio.conoce.destacado" class="text-neutral" />
        </h2>
        <Editable as="p" clave="inicio.conoce.cita" class="lead text-[1.13rem] text-primary max-nav:text-[1rem] max-tablet:text-[1.1rem]" />
        <Editable as="p" clave="inicio.conoce.texto" class="mb-[25px] max-w-[430px] text-[0.88rem] max-tablet:max-w-none" />
        <a class="button" href="/acerca-de-nosotros/">
          Acerca de nosotros <Icon name="arrow" size={19} />
        </a>
        <div data-cifras class="mt-[34px] grid max-w-[560px] grid-cols-2 rounded-[12px] bg-primary px-7 py-6 text-white [box-shadow:0_10px_0_#06317626] max-tablet:max-w-none max-mobile:grid-cols-1 max-mobile:gap-5 max-mobile:px-6">
          {CIFRAS.map(({ cifra, clave }, i) => (
            <div class:list={[i ? "border-l border-white/25 pl-6 max-mobile:border-t max-mobile:border-l-0 max-mobile:pt-5 max-mobile:pl-0" : "pr-6"]}>
              <strong data-cifra={cifra} data-valor={cifras?.[cifra] ?? ""} class="block font-display text-[clamp(3.4rem,5vw,5rem)] leading-[0.9] font-bold text-accent">
                {cifras ? formato.format(cifras[cifra]) : "—"}
              </strong>
              <Editable clave={clave} class="mt-3 block text-[0.78rem] leading-snug font-bold tracking-[0.1em] uppercase" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section
    id="propuestas"
    class="proposals-section bg-base-200 py-section [scroll-margin-top:20px]"
  >
    <div class="site-container">
      <div class="mb-10 flex items-end justify-between gap-[30px] max-tablet:mb-[25px] max-tablet:block">
        <div>
          <Editable clave="inicio.propuestas.antetitulo" class="eyebrow" />
          <h2 class="mt-2.5 mr-0 mb-0 text-[3.3rem] max-nav:text-[2.8rem]">
            <Editable clave="inicio.propuestas.titulo" />{" "}
            <Editable clave="inicio.propuestas.destacado" class="text-neutral max-tablet:block" />
          </h2>
        </div>
        <p class="mt-0 mr-0 mb-[5px] ml-0 text-[0.83rem] max-nav:max-w-[200px] max-tablet:mt-[18px] max-tablet:max-w-none max-tablet:text-[0.82rem]">
          <Editable clave="inicio.propuestas.texto-1" />
          <br class="max-tablet:hidden" />
          <Editable clave="inicio.propuestas.texto-2" />
        </p>
      </div>
      <div class="grid grid-cols-[repeat(4,1fr)] gap-[18px] max-nav:grid-cols-[repeat(2,1fr)] max-tablet:gap-3 max-mobile-xs:grid-cols-[1fr]">
        {proposals.map((p) => (
          <a
            class="proposal-card flex min-h-[242px] flex-col rounded-[4px] bg-base-100 p-7 text-primary [border-right:1px_solid_#06317630] [border-bottom:1px_solid_#06317630] [border-left:1px_solid_#06317630] [border-top:4px_solid_var(--color-secondary)] [box-shadow:0_4px_14px_#06317608] [transition:transform_0.2s,border-color_0.2s,box-shadow_0.2s] hover:-translate-y-1 hover:border-neutral hover:bg-base-100 hover:[box-shadow:0_8px_20px_#06317618] max-nav:min-h-[220px] max-desktop-sm:p-[23px] max-tablet:min-h-[225px] max-tablet:px-4 max-tablet:py-5 max-mobile-xs:min-h-[210px]"
            href={`/propuestas/${p.slug}/`}
          >
            <div class="card-top mb-7 flex items-center justify-between max-tablet:mb-6">
              <span class="proposal-icon text-neutral">
                <Icon name={p.icon} size={34} />
              </span>
              <Icon name="arrow" size={20} />
            </div>
            <span class="mb-2 text-[0.7rem] font-bold tracking-[0.06em] text-primary uppercase max-tablet:leading-[1.4]">
              {p.label}
            </span>
            <h3 class="mb-[22px] font-display text-[1.8rem] leading-[1.15] font-semibold max-tablet:mb-[18px]">
              {p.name}
            </h3>
            <span class="mt-auto text-[0.8rem] font-bold text-neutral">
              Conocer propuesta
            </span>
          </a>
        ))}
        <a
          class="group flex flex-col rounded-[4px] bg-campaign-red p-7 text-primary-content [transition:transform_0.2s] hover:-translate-y-1 max-tablet:px-4 max-tablet:py-5"
          href="/ciudadania/sugerencias/"
        >
          <Icon name="idea" size={34} />
          <h3 class="my-[18px] font-display text-[2rem] font-semibold max-tablet:text-[1.8rem]">
            ¿Y tú,
            <br />
            qué propones?
          </h3>
          <span class="mt-auto flex min-h-8 items-center justify-between text-[0.76rem] font-bold group-hover:underline max-tablet:gap-[5px] max-tablet:text-[0.65rem]">
            Comparte tu idea <Icon name="arrow" size={18} />
          </span>
        </a>
      </div>
    </div>
  </section>
  <section
    id="contacto"
    class="contact-section bg-secondary py-section"
    aria-labelledby="contact-title"
  >
    <div class="site-container grid grid-cols-[0.8fr_1.35fr] items-center gap-[72px] max-laptop:grid-cols-[1fr] max-laptop:gap-8">
      <div class="contact-intro">
        <Editable clave="inicio.contacto.antetitulo" class="eyebrow text-[0.85rem] tracking-[0.1em]" />
        <h2
          id="contact-title"
          class="mx-0 mt-4 mb-[22px] font-display text-[clamp(3.6rem,5vw,5.2rem)] leading-[1.08] font-semibold tracking-[-0.01em] text-neutral max-tablet:mt-3 max-tablet:mb-[18px] max-tablet:text-[3.5rem]"
        >
          <Editable clave="inicio.contacto.titulo" />
          <br class="max-laptop:hidden" />
          <Editable clave="inicio.contacto.destacado" class="text-inherit" />
        </h2>
        <Editable as="p" clave="inicio.contacto.texto" class="mb-[26px] max-w-[370px] text-[1.125rem] leading-[1.8] font-medium text-primary max-laptop:max-w-[640px] max-tablet:mb-0" />
        <Editable clave="global.lema" class="inline-block border-t-2 border-t-primary pt-[15px] text-[1rem] font-bold max-tablet:hidden" />
      </div>
      <div class="">
        <div class="grid grid-cols-[repeat(2,minmax(0,1fr))] gap-5 max-laptop:gap-[15px] max-mobile:grid-cols-[1fr]">
          {contactos.map((s) => (
            <a
              class="group flex flex-col rounded-[10px] border-2 border-transparent bg-base-100 p-7 text-primary [box-shadow:0_6px_0_#06317614] [transition:transform_0.18s,border-color_0.18s,box-shadow_0.18s] hover:-translate-y-1 hover:border-primary hover:[box-shadow:0_10px_0_#06317614] max-laptop:p-[22px] max-tablet:p-5 max-mobile:p-6"
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.etiqueta}
            >
              <div class="network-card-top mb-[26px] flex items-center justify-between max-tablet:mb-5 max-mobile:mb-[18px]">
                <span class:list={["network-icon grid h-[52px] w-[52px] place-items-center rounded-[50%] text-primary-content", s.fondo]}>
                  <Icon name={s.red} size={32} />
                </span>
                <Icon name="external" size={22} />
              </div>
              <h3 class="mb-2 font-sans text-[1.65rem] leading-[1.3] font-bold tracking-[-0.025em] max-tablet:text-[1.6rem]">
                {s.nombre}
              </h3>
              {s.usuario && <span class="text-[0.95rem] font-medium text-neutral [overflow-wrap:anywhere]">{s.usuario}</span>}
              <Editable as="p" clave={s.clave} class="mx-0 mt-[18px] mb-0 text-[1rem] leading-[1.75] text-primary max-tablet:mt-3.5" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
  <script src="../scripts/inicio/index.ts"></script>
</Layout>
