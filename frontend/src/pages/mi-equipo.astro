---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/comun/Breadcrumb.astro";
import Editable from "../components/comun/Editable.astro";
import Icon from "../components/comun/Icon.astro";
import Parroquia from "../components/mi-equipo/Parroquia.astro";
import Persona from "../components/mi-equipo/Persona.astro";
import { contentRepository } from "../lib/data";

const { members, parishes } = await contentRepository.getMyTeam();
---

<Layout title="Mi equipo · Carlos Astudillo" description="Conoce al equipo de Carlos Astudillo para el Concejo de San Lorenzo y lo que proponen para cada parroquia.">
  <Breadcrumb items={[{ label: "Inicio", href: "/" }, { label: "Mi equipo" }]} />
  <section class="bg-base-100">
    <div class="site-container max-w-[1100px] pt-[30px] pb-14 max-tablet:pt-6 max-tablet:pb-10">
      <header class="mx-auto max-w-[700px] text-center">
        <Editable clave="equipo.antetitulo" class="eyebrow justify-center" />
        <Editable as="h1" clave="equipo.titulo" class="mt-3 mb-4 text-[clamp(2.5rem,4vw,3.4rem)] max-tablet:text-[2.4rem]" />
        <Editable as="p" clave="equipo.texto" class="m-0 text-[1rem] leading-[1.7]" />
      </header>

      {members.length > 0 && (
        <ul class="mt-8 grid list-none grid-cols-3 gap-6 p-0 max-laptop:gap-4 max-tablet:gap-3 max-mobile:grid-cols-2" aria-label="Integrantes del equipo">
          {members.map((member) => <Persona member={member} />)}
        </ul>
      )}

      <section class="mt-10 max-tablet:mt-8">
        <details class="group/parroquias">
          <summary class="flex min-h-[68px] cursor-pointer list-none items-center gap-4 rounded-[4px] bg-primary px-6 py-3 text-primary-content group-open/parroquias:rounded-b-none max-tablet:gap-3 max-tablet:px-4 [&::-webkit-details-marker]:hidden">
            <Icon name="location" size={24} />
            <h2 class="m-0 flex-1 text-[2rem] max-tablet:text-[1.6rem]">Parroquias</h2>
            <span class="rounded-full bg-accent px-3 py-1 text-[0.8rem] font-bold text-primary">{parishes.length}</span>
            <span aria-hidden="true" class="group-open/parroquias:rotate-180"><Icon name="chevron" size={20} /></span>
          </summary>
          <ol class="m-0 list-none rounded-b-[4px] border border-t-0 border-base-300 p-0">
            {parishes.map((parish, i) => (
              <li class="border-b border-base-300 last:border-b-0"><Parroquia parish={parish} number={i + 1} /></li>
            ))}
          </ol>
        </details>
      </section>
    </div>
  </section>
</Layout>

<script>
  import { montarVisor } from "../lib/comun/visor-fotos";
  document.querySelectorAll<HTMLElement>("[data-carrusel]").forEach((carrusel) => { if (carrusel.querySelector("[data-visor]")) montarVisor(carrusel); });
</script>
