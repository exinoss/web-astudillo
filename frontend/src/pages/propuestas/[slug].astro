---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/comun/Icon.astro";
import Breadcrumb from "../../components/comun/Breadcrumb.astro";
import Editable from "../../components/comun/Editable.astro";
import DetailBanner from "../../components/comun/DetailBanner.astro";
import EvidenceCarousel from "../../components/ciudadania/EvidenceCarousel.astro";
import KpiStrip from "../../components/propuestas/KpiStrip.astro";
import Model3D from "../../components/propuestas/Model3D.astro";
import ObraProgreso from "../../components/ciudadania/ObraProgreso.astro";
import { contentRepository } from "../../lib/data";
import type { Proposal, WorkProgress } from "../../lib/data/types";

interface Props {
  proposal: Proposal;
  work?: WorkProgress;
}

export async function getStaticPaths() {
  const [proposals, works] = await Promise.all([contentRepository.getProposals(), contentRepository.getWorks()]);
  return proposals.map((p) => ({
    params: { slug: p.slug },
    props: { proposal: p, work: works.find((w) => w.proposalSlug === p.slug) },
  }));
}
const { proposal, work } = Astro.props;
// El visor 3D trae su propio margen superior; dentro de la fila de la obra lo marca la rejilla.
const fila = "mt-3.5 grid grid-cols-2 gap-[18px] max-tablet:grid-cols-1 max-tablet:gap-3 [&>.model-3d]:mt-0";
---

<Layout title={`${proposal.name} · Carlos Astudillo`} description={`${proposal.name}: ${proposal.intro}`}>
  <Breadcrumb
    items={[
      { label: "Inicio", href: "/" },
      { label: "Propuestas", href: "/#propuestas" },
      { label: proposal.name },
    ]}
  />
  <DetailBanner
    eyebrow={`PROPUESTAS · ${proposal.label.toUpperCase()}`}
    title={proposal.name}
    icon={proposal.icon}
    iconSize={76}
    lead={proposal.intro}
  />
  <KpiStrip kpis={proposal.kpis} label={`Cifras de la propuesta ${proposal.name}`} />
  <article class="site-container pt-8 pb-14 max-tablet:pt-6 max-tablet:pb-10">
    <Editable clave="propuesta.antetitulo" class="eyebrow" />
    <Editable as="h2" clave="propuesta.titulo" class="mt-[15px] max-tablet:text-[2.6rem]" />
    <Editable as="p" clave="propuesta.texto" class="max-w-[680px]" />
    {work ? (
      <section class="pt-8" aria-labelledby="obra-titulo">
        <Editable as="h3" clave="propuesta.obra.antetitulo" id="obra-titulo" class="eyebrow m-0" />
        {proposal.model ? (
          <>
            <div class={fila}>
              <Model3D {...proposal.model} />
              <EvidenceCarousel id={proposal.slug} evidence={work.evidence} name={proposal.name} />
            </div>
            <ObraProgreso work={work} proposal={proposal} enPropuesta ancho class="mt-[18px]" />
          </>
        ) : (
          <div class={fila}>
            <ObraProgreso work={work} proposal={proposal} enPropuesta />
            <EvidenceCarousel id={proposal.slug} evidence={work.evidence} name={proposal.name} />
          </div>
        )}
      </section>
    ) : (
      <>
        {proposal.model && <div class="max-w-[860px]"><Model3D {...proposal.model} /></div>}
        <div class="mt-[30px] flex max-w-[860px] items-start gap-[18px] [border-left:3px_solid_var(--color-accent)] bg-base-200 p-[25px]">
          <Icon name="book" size={24} />
          <div>
            <Editable as="strong" clave="propuesta.preparacion.titulo" />
            <Editable as="p" clave="propuesta.preparacion.texto" class="mt-2 mr-0 mb-0 ml-0 text-[0.88rem]" />
          </div>
        </div>
      </>
    )}
    <Editable as="h3" clave="propuesta.perspectiva.titulo" class="mt-10" />
    <p class="max-w-[680px]">
      <Editable clave="propuesta.perspectiva.texto" /> {proposal.name.toLowerCase()}.
    </p>
    <a
      class="button max-tablet:gap-3.5 max-tablet:text-[0.75rem]"
      href={`/ciudadania/sugerencias/?tema=${proposal.slug}`}
    >
      Compartir una sugerencia <Icon name="arrow" size={18} />
    </a>
  </article>
</Layout>
