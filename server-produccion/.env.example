# Copia este archivo como server-produccion/.env en el VPS y complétalo. Nunca lo subas a Git.

# Dominio público, sin https:// (el sitio, la API y los enlaces de los correos usan https://DOMINIO).
DOMINIO=lanuevahistoria.tech

# PostgreSQL: una clave distinta para cada usuario, solo letras y números (van dentro de la URL de conexión).
# Genera cada una con: openssl rand -hex 32
# Solo se aplican la primera vez que arranca la base: cambiarlas aquí después no cambia las de la base.
# Superusuario «postgres»: solo para mantenimiento y respaldos, ningún servicio lo usa.
POSTGRES_PASSWORD=
# Migraciones (dueño de las tablas).
DB_MIGRA_PASSWORD=
# Backend.
DB_APP_PASSWORD=
# Publicador.
DB_PUB_PASSWORD=

# Al menos 32 caracteres aleatorios, por ejemplo: openssl rand -base64 48
JWT_SECRET=
# ID del cliente web de Google; autoriza https://DOMINIO como origen en Google Auth Platform.
GOOGLE_CLIENT_ID=

# Correo saliente de producción.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
